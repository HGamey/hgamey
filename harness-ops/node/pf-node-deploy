#!/bin/zsh
# 让手机节点自己从 GitHub 拉代码、编译、更新（节点上的 update_node.sh --git）。开发机只发一条小指令，不传文件。
# 用法: pf-node-deploy [phonefarm[@ref]] [game_opt_loop[@ref]] [harness-ops[@ref]]   缺省 phonefarm game_opt_loop @ origin/main
#   含 harness-ops 时，更新后自动 /admin/restart 节点服务。
set -eu
pf-node --label deploy update_node --git "$@"
if (( ${@[(I)harness-ops*]} )); then
  curl -sS -m 30 -X POST -A pf-node/1 -H "Authorization: Bearer $(cat ~/.config/hgamey/node.token)" \
    ${PF_NODE_URL:-https://phone.liyao.space}/admin/restart; echo
fi

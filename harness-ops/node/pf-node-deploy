#!/bin/zsh
# 让手机节点自己从 GitHub 拉代码、编译、更新（节点上的 update_node.sh --git）。开发机只发一条小指令，不传文件。
# 用法: pf-node-deploy [--restart] [phonefarm[@ref]] [game_opt_loop[@ref]] [harness-ops[@ref]]
#   缺省 phonefarm game_opt_loop @ origin/main。
#   --restart：更新后 /admin/restart 节点服务（只在 node_service.py / dash 有改动时才需要；
#   任务退出码已落盘，重启不再丢任务状态；仍建议先看 `pf-node devlock status` 和实时看板）。
#   目标与凭据沿 pf-node：显式 PF_NODE_URL、PF_NODE_ID 和 PF_NODE_TOKEN / PF_NODE_TOKEN_FILE。
set -eu
restart=0; [[ ${1:-} == --restart ]] && { restart=1; shift; }
${0:A:h}/pf-node --label deploy update_node --git "$@"
if (( restart )); then
  # The same explicit URL/ID is rechecked; an unknown restart is never retried.
  ${0:A:h}/pf-node admin-restart
fi

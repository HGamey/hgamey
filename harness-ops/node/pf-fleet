#!/usr/bin/env python3
"""pf-fleet：跨节点调度层 —— 在多台手机节点之间看全貌、派任务。

  pf-fleet --hub URL status --refresh --json       # 共享目录；异步刷新，不等待远端
  pf-fleet --hub URL show NAME --devices           # 明确请求设备采样
  pf-fleet --hub URL register NAME --url URL --token-file FILE
  pf-fleet --hub URL update NAME --revision N --note TEXT
  pf-fleet --hub URL disable|enable NAME --revision N
  pf-fleet --hub URL import nodes.json --json      # 逐条创建；不覆盖、不删源文件
  PF_FLEET_HUB=URL pf-fleet nodes                 # 同一共用目录
  # hub 认证仅使用 PF_NODE_TOKEN(_FILE)；hub 模式 run/migrate 尚未支持，不回落。

  pf-fleet nodes                          # 列出注册表里的节点
  pf-fleet status [--json]                # 并行问所有节点：在线？锁谁持有？手机清单（fleet 只读快照）
  pf-fleet run --node example -- <pf-node 参数…>      # 派到指定节点
  pf-fleet run --tag android -- <…>                  # 派到第一台「在线、锁空闲、带这个标签」的节点
  pf-fleet run --any-free -- <…>                      # 派到第一台「在线、锁空闲」的节点

设计纪律：
- 本层只做「去哪台」，不做第二把锁。拿到任务后的排队/互斥仍然只有节点上的 devlock 一份语义。
- 状态只读 GET /fleet，不创建任务。PF_FLEET_TIMEOUT 秒（缺省 12）是整批探测的总时限；
  每个注册节点都有结果，超时/未知/陈旧快照不能作为自动选机的空闲依据。
- run 不自己实现传输/任务协议：选好节点后置 PF_NODE_URL / PF_NODE_TOKEN_FILE，exec 同目录的 pf-node。

注册表（JSON）：显式 --registry FILE 或 PF_FLEET_REGISTRY，不搜索其他目录：
{
  "nodes": [
    {"name": "example", "url": "https://node.example.invalid",
     "token_file": ".hgamey/node.token",          # 相对注册表所在目录；也可给绝对路径
     "tags": ["android", "fixture"],
     "ssh": "example-node",                        # 旧元数据；当前不执行迁移
     "goals_dir": "/Users/me/node/goals",          # 可选：目标运行目录的父目录（migrate 用）
     "note": "显式登记的示例节点"}
  ]
}

  legacy migrate 暂不支持：SSH/rsync 的目标身份尚无本批绑定合同。
  hub 写入需 --node-id ID / PF_NODE_ID；只读 node 可发现 hub ID。
"""
import json, math, os, queue, shutil, subprocess, sys, tempfile, threading, time
import urllib.request, urllib.error

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from target_client import Target, TargetError, node_id, token_file


def _registry_path(explicit=None):
    path = explicit if explicit is not None else os.environ.get("PF_FLEET_REGISTRY")
    if not path:
        sys.exit("pf-fleet: 需显式 --registry FILE 或 PF_FLEET_REGISTRY；未搜索其他注册表")
    return path


def load_registry(explicit=None):
    p = _registry_path(explicit)
    with open(p) as source:
        reg = json.load(source)
    base = os.path.dirname(p)
    for n in reg.get("nodes", []):
        tf = n.get("token_file", "")
        if tf and not os.path.isabs(tf):
            n["token_file"] = os.path.normpath(os.path.join(base, tf))
        n.setdefault("tags", [])
    return reg.get("nodes", [])


def _get_fleet(url, token, timeout, expected_node_id=None):
    target = Target(url, token, expected_node_id, credential_source="registry_file")
    identity = target.identity(timeout=timeout)
    # Legacy selection explicitly freezes this discovery; ordinary direct CLI
    # writes never adopt a newly discovered identity on their own.
    target.expected_node_id = node_id(identity.get("node_id"))
    target.require_write()  # GET /fleet schedules sampling; require enforcement.
    req = target.request("GET", "/fleet?wait=5")
    with target.opener.open(req, timeout=timeout) as response:
        fleet = json.load(response)
    if not isinstance(fleet, dict) or fleet.get("node_id") != target.expected_node_id:
        raise TargetError("target_mismatch", "fleet 快照未匹配刚核实的 node_id")
    return fleet


def _unavailable(node, error):
    return {"name": node["name"], "url": node["url"], "tags": node.get("tags", []),
            "ok": False, "reachable": None, "sample_ok": False, "available": False,
            "lock": "unknown", "lock_detail": {"status": "unknown", "queue": []},
            "lock_free": False, "devices": None, "stale": True, "error": error}


def probe_node(node, timeout):
    """只读一次宿主快照；HTTP 可达与设备采样成功分开记录。"""
    res = _unavailable(node, None)
    try:
        token = token_file(node["token_file"])
        fleet = _get_fleet(node["url"], token, timeout, node.get("node_id"))
        res["reachable"] = True
        if not isinstance(fleet, dict) or fleet.get("schema_version") != 1:
            raise ValueError("不支持的 /fleet 协议；请升级节点服务")
        lock = fleet.get("lock")
        if not isinstance(lock, dict) or lock.get("status") not in ("free", "held", "unknown"):
            raise ValueError("/fleet 未返回有效锁状态")
        res.update(fleet)
        res.update(name=node["name"], url=node["url"], tags=node.get("tags", []),
                   reachable=True, ok=True, lock_detail=lock)
        # 保留旧 status JSON 的锁字符串；完整结构另外保留，设备字段原样返回。
        res["lock"] = ("held: " + str(lock.get("held_by") or "unknown")) if lock["status"] == "held" else lock["status"]
        if lock["status"] == "held" and lock.get("since") is not None:
            res["lock"] += f" since {lock['since']}"
        res["lock_free"] = (lock["status"] == "free" and lock.get("queue") == []
                            and lock.get("stale") is False and not lock.get("error"))
        res["sample_ok"] = (isinstance(fleet.get("devices"), list)
                            and fleet.get("sampled_at") is not None
                            and fleet.get("stale") is False
                            and not fleet.get("error") and not fleet.get("deferred"))
        res["available"] = res["lock_free"] and res["sample_ok"]
    except urllib.error.HTTPError as e:
        res["reachable"] = True
        res["error"] = ("节点不支持 GET /fleet，请升级节点服务（HTTP 404）" if e.code == 404
                        else f"HTTP {e.code}: 节点已响应，但状态请求失败")
        e.close()
    except Exception as e:  # 宕机/530/超时都走这里：记下原因，不拖住其他节点
        res["error"] = f"{type(e).__name__}: {e}"[:200]
    return res


def probe_nodes(nodes, timeout=None):
    """所有线程共享总时限；只有本线程写结果，迟到线程不能覆盖超时占位。"""
    timeout = float(os.environ.get("PF_FLEET_TIMEOUT", 12)) if timeout is None else timeout
    if not math.isfinite(timeout) or timeout <= 0:
        sys.exit("pf-fleet: PF_FLEET_TIMEOUT 必须是正数秒")
    deadline = time.monotonic() + timeout
    results = [_unavailable(n, f"状态探测超时（总时限 {timeout:g}s）") for n in nodes]
    completed = queue.Queue()

    def worker(index, node):
        remaining = deadline - time.monotonic()
        if remaining > 0:
            result = probe_node(node, remaining)
            completed.put((index, result, time.monotonic()))

    for index, node in enumerate(nodes):
        threading.Thread(target=worker, args=(index, node), daemon=True).start()
    for _ in nodes:
        try:
            index, result, finished = completed.get(timeout=max(0, deadline - time.monotonic()))
        except queue.Empty:
            break
        if finished <= deadline:
            results[index] = result
    return results


def cmd_nodes(nodes, _):
    for n in nodes:
        print(f"{n['name']:<12} {n['url']:<40} tags={','.join(n['tags'])}  {n.get('note', '')}")


def cmd_status(nodes, argv):
    as_json = "--json" in argv
    out = probe_nodes(nodes)
    out.sort(key=lambda r: r["name"])
    if as_json:
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return
    for r in out:
        if not r["ok"]:
            state = "节点已响应" if r.get("reachable") else "状态不可用"
            print(f"{r['name']:<12} ✗ {state}（{r.get('error', '?')}）")
            continue
        lock = r.get("lock", "?")
        locks = "未知"
        if lock == "free":
            locks = "空闲"
        elif lock.startswith("held:"):
            locks = "占用(" + lock[6:].split(" since")[0] + ")"
        lock_detail = r["lock_detail"]
        if lock_detail.get("queue"):
            locks += f"，排队 {len(lock_detail['queue'])}"
        if lock_detail.get("stale") or lock_detail.get("error"):
            locks = "未知（锁状态陈旧/异常）"
        parts = []
        for d in r.get("devices") or []:
            bat = d.get("battery") or {}
            fan = d.get("fan") or {}
            s = f"{d.get('model', '?')}({str(d.get('serial', '?'))[:8]})"
            if bat.get("level_pct") is not None:
                s += f" 电{bat['level_pct']}%"
            if bat.get("temp_c") is not None:
                s += f" {bat['temp_c']:.0f}°C"
            if fan.get("supported"):
                s += " 风扇" + ("开!" if fan.get("enabled") else "关")
            parts.append(s)
        dsum = "；".join(parts) or ("无设备" if r.get("devices") == [] and r["sample_ok"] else "设备清单未取到")
        sample = "" if r["sample_ok"] else "；采样未就绪: " + str(r.get("error") or r.get("deferred") or "快照陈旧/尚未采样")
        print(f"{r['name']:<12} ✓ 节点 {r.get('node_id', '?')} 锁: {locks} 设备: {dsum}{sample}")


def cmd_run(nodes, argv):
    node_name, use_tag, any_free = None, None, False
    rest = list(argv)
    while rest and rest[0] != "--":
        a = rest.pop(0)
        if a == "--node":
            node_name = rest.pop(0)
        elif a == "--tag":
            use_tag = rest.pop(0)
        elif a == "--any-free":
            any_free = True
        else:
            sys.exit(f"pf-fleet run: 不认识 {a}（支持 --node/--tag/--any-free，之后用 -- 隔开 pf-node 参数）")
    if rest and rest[0] == "--":
        rest.pop(0)
    if not rest:
        sys.exit("pf-fleet run: -- 后面要给 pf-node 的参数")
    if not (node_name or use_tag or any_free):
        sys.exit("pf-fleet run: 要指定 --node NAME 或 --tag TAG 或 --any-free")

    cands = nodes
    if node_name:
        cands = [n for n in nodes if n["name"] == node_name]
        if not cands:
            sys.exit(f"pf-fleet run: 注册表里没有节点 {node_name}")
    if use_tag:
        cands = [n for n in cands if use_tag in n["tags"]]
        if not cands:
            sys.exit(f"pf-fleet run: 没有带标签 {use_tag} 的节点")

    probe_out = probe_nodes(cands)
    by_name = {r["name"]: r for r in probe_out}
    chosen = None
    for n in cands:  # 保持注册表顺序 = 优先级
        r = by_name.get(n["name"])
        if r and r.get("ok") and (r.get("available") or node_name):
            chosen = n
            break
    if not chosen:
        detail = "; ".join(f"{r['name']}: {r.get('error') or r.get('deferred') or ('快照陈旧/尚未采样' if not r.get('sample_ok') else '锁非空闲或有排队')}" for r in probe_out)
        sys.exit(f"pf-fleet run: 没有可用节点（{detail or '无候选'}）")

    selected_id = node_id(by_name[chosen["name"]].get("node_id"))
    if chosen.get("node_id") is not None and chosen["node_id"] != selected_id:
        sys.exit("pf-fleet: 所选节点身份与登记不符；未提交")
    # Only pf-node's global prefix can override the selected connection. A
    # target program may independently have an argument named --url.
    index = 0
    valued = {"-o", "--out-dir", "--exe", "--label", "--inputs", "--request-id", "--resource",
              "--device-access", "--execution-policy", "--recovery-for"}
    while index < len(rest) and rest[index].startswith("-"):
        option = rest[index].split("=", 1)[0]
        if option in {"--url", "--node-id", "--token-file"}:
            sys.exit("pf-fleet: pf-node 参数不能覆盖已选 URL、node_id 或凭据文件")
        index += 2 if option in valued else 1
    print(f"pf-fleet: 派到 {chosen['name']}（{chosen['url']}），node_id={selected_id}", file=sys.stderr)
    env = dict(os.environ)
    for key in ("PF_NODE_TOKEN", "PF_NODE_TOKEN_FILE", "PF_NODE_URL", "PF_NODE_ID"):
        env.pop(key, None)
    env["PF_NODE_URL"] = chosen["url"]
    env["PF_NODE_TOKEN_FILE"] = chosen["token_file"]
    env["PF_NODE_ID"] = selected_id
    os.execvpe(os.path.join(HERE, "pf-node"), ["pf-node"] + rest, env)


def cmd_migrate(nodes, argv):
    """pf-fleet migrate <run_id> --from A --to B：整体搬一次目标运行到另一台节点续跑。"""
    run_id, src_name, dst_name = None, None, None
    rest = list(argv)
    while rest:
        a = rest.pop(0)
        if a == "--from":
            src_name = rest.pop(0)
        elif a == "--to":
            dst_name = rest.pop(0)
        elif run_id is None:
            run_id = a
        else:
            sys.exit(f"pf-fleet migrate: 不认识 {a}")
    if not (run_id and src_name and dst_name):
        sys.exit("用法: pf-fleet migrate <run_id> --from <节点> --to <节点>")
    by = {n["name"]: n for n in nodes}
    src, dst = by.get(src_name), by.get(dst_name)
    if not src or not dst:
        sys.exit(f"pf-fleet migrate: 节点不在注册表（{src_name}/{dst_name}）")
    for n, role in ((src, "--from"), (dst, "--to")):
        if not n.get("ssh") or not n.get("goals_dir"):
            sys.exit(f"pf-fleet migrate: {n['name']} 的注册表项缺 ssh/goals_dir 字段")
    if src_name == dst_name:
        sys.exit("pf-fleet migrate: --from 和 --to 是同一台")

    staging = os.path.join(tempfile.mkdtemp(prefix="pf-fleet-migrate-"), run_id)
    src_dir = f"{src['goals_dir'].rstrip('/')}/{run_id}"
    dst_dir = f"{dst['goals_dir'].rstrip('/')}/{run_id}"
    print(f"[1/3] {src_name}:{src_dir} → 本机中继", file=sys.stderr)
    subprocess.run(["rsync", "-az", "--timeout=60", f"{src['ssh']}:{src_dir}/", staging + "/"], check=True)
    # 状态别带跑：源上的 state 是 running 才好（进程已死前提）；done/failed 没必要搬
    st = json.load(open(os.path.join(staging, "state.json")))
    if st.get("status") not in ("running", "paused"):
        sys.exit(f"这次运行状态是 {st.get('status')}（第 {st.get('generation')} 代），不是半死状态，不用搬")
    print(f"[2/3] 本机中继 → {dst_name}:{dst_dir}", file=sys.stderr)
    subprocess.run(["ssh", "-o", "BatchMode=yes", dst["ssh"], "mkdir", "-p", dst["goals_dir"]], check=True)
    subprocess.run(["rsync", "-az", "--timeout=60", staging + "/", f"{dst['ssh']}:{dst_dir}/"], check=True)
    shutil.rmtree(os.path.dirname(staging), ignore_errors=True)
    print(f"[3/3] 在 {dst_name} 上 goal resume", file=sys.stderr)
    cmd_run(nodes, ["--node", dst_name, "--", "game_opt_loop", "goal", "resume", dst_dir])


def main():
    argv = sys.argv[1:]
    hub = os.environ.get("PF_FLEET_HUB")
    registry = expected_node_id = explicit_file = None
    while argv and argv[0].startswith("--") and argv[0] != "--help":
        option, separator, value = argv.pop(0).partition("=")
        if option not in {"--hub", "--registry", "--node-id", "--hub-token-file"}:
            sys.exit("pf-fleet: 未识别全局选项，详见 --help")
        if not separator:
            if not argv:
                sys.exit(f"pf-fleet: {option} 需要一个值")
            value = argv.pop(0)
        if option == "--hub":
            hub = value
        elif option == "--registry":
            registry = value
        elif option == "--node-id":
            expected_node_id = value
        else:
            explicit_file = value
    if hub is not None:
        from fleet_client import main as managed_main
        if registry is not None:
            sys.exit("pf-fleet: --registry 与 hub 模式不能混用")
        sys.exit(managed_main(hub, argv, expected_node_id=expected_node_id, explicit_file=explicit_file))
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0 if argv else 2)
    cmd, argv = argv[0], argv[1:]
    if expected_node_id is not None or explicit_file is not None:
        sys.exit("pf-fleet: --node-id/--hub-token-file 用于 hub；legacy run 冻结所选登记身份和凭据")
    if cmd == "migrate":
        sys.exit("pf-fleet: legacy migrate 的 SSH 目标绑定尚未支持；未执行迁移或恢复")
    nodes = load_registry(registry)
    {"nodes": cmd_nodes, "status": cmd_status, "run": cmd_run, "migrate": cmd_migrate}.get(
        cmd, lambda *_: sys.exit(f"pf-fleet: 不认识子命令 {cmd}（nodes/status/run/migrate）")
    )(nodes, argv)


if __name__ == "__main__":
    try:
        main()
    except (TargetError, OSError, ValueError):
        sys.exit("pf-fleet: 显式注册表、目标身份或凭据无效；未选择其他配置")

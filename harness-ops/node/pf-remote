#!/usr/bin/env python3
"""Explicit operator client; never retries a remote device action automatically."""
import argparse
from http.client import HTTPException
import json
from pathlib import Path
import sys
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlencode, urlsplit
from target_client import Target, TargetError


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--url', help='exact node URL or PF_NODE_URL (HTTPS; HTTP allowed on loopback)')
    ap.add_argument('--node-id', help='expected persistent node ID or PF_NODE_ID; required for actions')
    ap.add_argument('--token-file', help='explicit operator credential file, takes precedence over PF_NODE_TOKEN(_FILE)')
    subs = ap.add_subparsers(dest='command', required=True)
    subs.add_parser('devices')
    subs.add_parser('node', help='read-only discovery using the operator credential')
    acquire = subs.add_parser('acquire')
    acquire.add_argument('serial')
    acquire.add_argument('--request-id', required=True)
    acquire.add_argument('--max-minutes', type=int, default=60)
    session = subs.add_parser('session')
    session.add_argument('serial')
    identity = session.add_mutually_exclusive_group(required=True)
    identity.add_argument('--session-id')
    identity.add_argument('--acquisition-id')
    action = subs.add_parser('action')
    action.add_argument('serial')
    action.add_argument('action', choices=['tap','swipe','text','key','screenshot','app_start','app_stop','renew','release'])
    action.add_argument('--session-id', required=True)
    action.add_argument('--request-id', required=True)
    action.add_argument('--params', default='{}', help='typed JSON action parameters')
    action.add_argument('--out', help='new output file for a completed screenshot')
    receipt = subs.add_parser('receipt')
    receipt.add_argument('serial')
    receipt.add_argument('request_id')
    receipt.add_argument('--session-id', required=True)
    receipt.add_argument('--out', help='fetch the completed image into a new file; no device capture')
    args = ap.parse_args(argv)
    target = Target.resolve(args.url, args.node_id, args.token_file, identity_path='/remote/node')
    address = urlsplit(target.url)
    if address.scheme == 'http' and address.hostname not in ('127.0.0.1','localhost','::1'):
        ap.error('operator credentials require HTTPS outside loopback')
    if not target.token.startswith('hgop_'):
        ap.error('credential must be an operator token')
    if args.command == 'node':
        print(json.dumps(target.identity(), ensure_ascii=False, indent=2))
        return 0
    method, path, body = 'GET', '/remote/devices', None
    query_context = {}
    if args.command != 'devices':
        path += '/' + quote(args.serial, safe='')
        if args.command == 'acquire':
            method, path = 'POST', path + '/session'
            body = {'request_id': args.request_id, 'max_minutes': args.max_minutes}
            query_context = {'acquisition_id': args.request_id, 'serial': args.serial}
        elif args.command == 'session':
            query = {'session_id': args.session_id} if args.session_id else {'acquisition_id': args.acquisition_id}
            path += '/session?' + urlencode(query)
        elif args.command == 'action':
            params = json.loads(args.params)
            if not isinstance(params, dict) or {'session_id','request_id'} & params.keys():
                ap.error('--params must be an object without session_id/request_id')
            method, path = ('DELETE', path + '/session') if args.action == 'release' else ('POST', path + '/' + args.action)
            body = {**params, 'session_id': args.session_id, 'request_id': args.request_id}
            query_context = {'session_id': args.session_id, 'request_id': args.request_id, 'serial': args.serial}
        else:
            path += '/requests/' + quote(args.request_id, safe='') + '?' + urlencode(
                {'session_id': args.session_id, **({'image': '1'} if args.out else {})})
    query_context.update(url=target.url, node_id=target.expected_node_id)
    request = target.request(method, path, json.dumps(body).encode() if body is not None else None,
                             {'Content-Type': 'application/json'})
    try:
        response = target.opener.open(request, timeout=30)
    except HTTPError as error:
        response = error
    except (URLError, TimeoutError, OSError):
        print(json.dumps({'status': 'unknown' if body else 'unavailable', 'error': 'request result unavailable; retain the original target and request ID',
                          'query_required': bool(body), **query_context}, ensure_ascii=False))
        return 4
    try:
        with response:
            if response.status >= 300:
                unknown = bool(body) and (response.status < 400 or response.status >= 500)
                print(json.dumps({'status': 'unknown' if unknown else 'rejected', 'http_status': response.status,
                                  'error': 'request refused; redirects are not followed',
                                  'query_required': bool(body), **query_context}, ensure_ascii=False))
                return 4 if unknown else 1
            data = response.read((8 << 20) + 1)
            if len(data) > 8 << 20:
                raise ValueError('node response exceeds budget; query original request ID')
            if response.headers.get_content_type().startswith('image/'):
                value = json.loads(response.headers.get('X-Meta', '{}'))
                if args.out:
                    with Path(args.out).open('xb') as output:
                        output.write(data)
                    value['saved_to'] = str(Path(args.out).resolve())
                else:
                    value['image_saved'] = False
            else:
                value = json.loads(data)
            print(json.dumps(value, ensure_ascii=False, indent=2))
            if response.status >= 400:
                return 1
            if value.get('status') == 'unknown' or value.get('phase') in ('unknown','recovery_required'):
                return 4
            if value.get('status') in ('failed','not_executed'):
                return 1
            if value.get('status') in ('accepted','started') or value.get('phase') in ('starting','closing'):
                return 3
            return 0
    except (OSError, ValueError, HTTPException):
        print(json.dumps({'status': 'unknown' if body else 'unavailable', 'error': 'response could not be confirmed; retain the original target and request ID',
                          'query_required': bool(body), **query_context}, ensure_ascii=False))
        return 4



if __name__ == '__main__':
    try:
        sys.exit(main())
    except TargetError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError):
        print('invalid local input or unavailable output; no fallback target selected', file=sys.stderr)
        sys.exit(1)

def find_gray_session_request(request_id):
    """A supplied ID is queried before applying new-producer admission or packing."""
    try:
        value = json.loads(call("GET", "/requests/" + urllib.parse.quote(request_id, safe=""),
                                attempts=1, raise_errors=True))
        if (not isinstance(value, dict) or value.get("request_id") != request_id
                or not isinstance(value.get("id"), str) or not re.fullmatch(r"[0-9a-f]{12}", value["id"])):
            raise ValueError("回包未绑定原请求 ID 与任务")
        return value
    except ClientError as error:
        try:
            absent = error.code == 404 and json.loads(error.body).get("error") == "no such job"
        except (ValueError, AttributeError):
            absent = False
        if absent:
            return None
        sys.exit(f"pf-node: 原请求 {request_id} 查回未确认（HTTP {error.code}）；未打包或提交。用 {continuation()} request {request_id} 核对，不换 ID")
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, ValueError) as error:
        sys.exit(f"pf-node: 原请求 {request_id} 查回未确认；未打包或提交，不自动重试。用 {continuation()} request {request_id} 核对")


def submit_job(spec, body, request_id):
    print(f"pf-node: 提交 request_id={request_id}；结果未知时用 {continuation()} request {request_id} 找回任务。",
          file=sys.stderr, flush=True)
    headers = {"X-Job": json.dumps(spec, ensure_ascii=True), "X-Request-ID": request_id,
               "Content-Type": "application/gzip"}
    gray_session = is_gray_session(spec)
    try:
        meta = json.loads(call("POST", "/jobs", body, headers, timeout=600, raise_4xx=True,
                               **({"attempts": 1, "raise_errors": True} if gray_session else {})))
        meta["id"]  # A malformed response cannot confirm which job was accepted.
        return meta
    except ClientError as e:
        if gray_session and response_error_code(e.body) in {"program_protocol_unsupported", "program_identity_unavailable", "program_override_unsupported", "program_configuration_changed"}:
            payload = json.loads(e.body)
            sys.exit(f"pf-node: 新灰层会话准入被拒绝，request_id={request_id}；保留原 ID 核对，不自动刷新或重试：" + json.dumps(payload, ensure_ascii=False))
        if e.code == 422:
            try:
                payload = json.loads(e.body)
            except (ValueError, TypeError):
                payload = None
            if isinstance(payload, dict) and payload.get("code") == "host_capacity_exceeded":
                sys.exit(f"pf-node: 宿主容量准入被拒绝，request_id={request_id}；不会自动缩减需求："
                         + json.dumps(payload, ensure_ascii=False))
        if e.code == 409:
            sys.exit(f"pf-node: 提交条件冲突（HTTP 409），request_id={request_id}；"
                     f"请用 {continuation()} request {request_id} 核对原节点已有任务，"
                     "并检查恢复目标条件；不要换 request_id 盲目重投。")
        sys.exit(f"pf-node: 提交被拒绝，request_id={request_id}：{e}")
    except (SystemExit, ValueError, KeyError, KeyboardInterrupt, urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as e:
        print(f"pf-node: 提交结果未知，request_id={request_id}：{e}；"
              f"请用 {continuation()} request {request_id} 查询；不要换 request_id 重复提交。", file=sys.stderr)
        raise SystemExit(130 if isinstance(e, KeyboardInterrupt) else 1)


def cancel_job(jid, force=False):
    if force:
        print("pf-node: 强制取消将请求 SIGINT，15 秒后可升级 TERM，再 15 秒后可升级 KILL；可能打断恢复。",
              file=sys.stderr)
    try:
        result = json.loads(call("POST", f"/jobs/{jid}/cancel", json.dumps({"force": force}).encode(),
                                 {"Content-Type": "application/json"}, attempts=1, raise_4xx=True))
    except ClientError as e:
        if e.code in (401, 403):
            sys.exit("pf-node: 取消请求被拒绝；需要有效的管理 token（只读 token 不能取消任务）")
        if e.code == 404:
            sys.exit("pf-node: 取消请求被拒绝；任务不存在或节点不支持 /cancel，请核对任务并升级节点服务")
        sys.exit(f"pf-node: 取消请求被拒绝：{e}")
    if result.get("accepted") is True:
        print(f"pf-node: 任务 {jid} 的取消请求已记录；请通过 status/wait 查看后续状态，设备恢复尚未据此确认。",
              file=sys.stderr)
    else:
        print(f"pf-node: 任务 {jid} 的取消请求被拒绝：{result.get('reason') or '未说明原因'}", file=sys.stderr)
    return result


def release_job(jid, note):
    try:
        result = json.loads(call("POST", f"/jobs/{jid}/queue-release", json.dumps({"note": note}).encode(),
                                 {"Content-Type": "application/json"}, attempts=1, raise_4xx=True))
    except ClientError as e:
        if e.code in (401, 403):
            sys.exit("pf-node: 释放请求被拒绝；需要有效的管理 token")
        sys.exit(f"pf-node: 释放请求被拒绝：{e}")
    if result.get("released") is True:
        print(f"pf-node: 任务 {jid} 的核查记录已保存，已允许再次调度；这不证明设备已恢复。", file=sys.stderr)
    else:
        print(f"pf-node: 释放请求被拒绝：{result.get('reason') or '未说明原因'}", file=sys.stderr)
    return result


def terminal_exit(jid, status):
    rc = status.get("exit")
    phase = status.get("phase", status.get("state", "unknown"))
    management = (status.get("execution") or {}).get("process_management")
    if management:
        print(f"pf-node: 执行后端={management.get('backend')}，结束核查范围={management.get('completion_scope')}，"
              f"脱组后代={management.get('detached_descendants', '未提供')}；设备恢复另看 recovery。", file=sys.stderr)
    else:
        print("pf-node: 此记录未提供执行范围证据，不能据退出码推断全部后代已结束。", file=sys.stderr)
    intent = (status.get("execution") or {}).get("stop_intent")
    if intent:
        print("pf-node: worker 最后成功保存的停止意图（可能落后于实际执行）="
              + json.dumps(intent, ensure_ascii=False)
              + "；实际已发信号看 cancel.signals，停止与设备恢复另看对应记录；记录错误历史不表示当前磁盘剩余量。", file=sys.stderr)
    budget = (status.get("execution") or {}).get("time_budget") or {}
    exceeded_at = budget.get("exceeded_at")
    exceeded = isinstance(exceeded_at, (int, float)) and not isinstance(exceeded_at, bool) and math.isfinite(exceeded_at)
    if exceeded:
        print(f"pf-node: 运行期限已触发，原命令 exit={rc}，触发时间={exceeded_at}，"
              f"到期动作={budget.get('timeout_action')}；停止和设备恢复仍以独立记录为准。", file=sys.stderr)
    disk = (status.get("execution") or {}).get("disk_guard") or {}
    disk_at = disk.get("triggered_at")
    disk_triggered = isinstance(disk_at, (int, float)) and not isinstance(disk_at, bool) and math.isfinite(disk_at)
    known_disk_trigger = disk_triggered and disk.get("trigger_reason") in ("log_limit", "disk_space_low")
    if disk:
        print("pf-node: 最后成功保存的磁盘保护观察=" + json.dumps(disk, ensure_ascii=False)
              + "；不是实时空间或硬配额，触发不等于已停止或设备已恢复。", file=sys.stderr)
    group = (status.get("execution") or {}).get("owned_process_group") or {}
    if rc == 0 and group.get("status") in ("present", "unknown"):
        print(f"pf-node: 任务 {jid} 直接命令 exit=0，但原进程组结束未确认"
              f"（{group['status']}），CLI 返回 125；请核查任务和资源保留记录。", file=sys.stderr)
        return 125
    cgroup = (status.get("execution") or {}).get("owned_cgroup") or {}
    if (exceeded or disk_triggered) and rc == 0 and cgroup and cgroup.get("status") != "absent":
        print("pf-node: 运行期限或磁盘保护已触发，但执行域结束未确认；CLI 返回 125。", file=sys.stderr)
        return 125
    unknown = (not isinstance(rc, int) or isinstance(rc, bool) or rc == -1
               or (phase == "interrupted" and rc == 0))
    print(f"pf-node: 任务 {jid} 记录终态 phase={phase}，outcome={status.get('outcome', '未报告')}，"
          f"recovery={status.get('recovery', '未报告')}；"
          + ("原命令 exit=0，但执行中断，CLI 返回 125" if phase == "interrupted" and rc == 0
             else "没有可信退出码，CLI 返回 125" if unknown else f"exit={rc}"), file=sys.stderr)
    if unknown:
        return 125
    if exceeded and rc == 0:
        print("pf-node: 原命令 exit=0，但 worker 已触发运行期限；CLI 返回 124，不代表设备已恢复。", file=sys.stderr)
        return 124
    if known_disk_trigger and rc == 0:
        print("pf-node: 原命令 exit=0，但 worker 已触发已知日志/空间软阈值；CLI 返回 124，不代表设备已恢复。", file=sys.stderr)
        return 124
    return rc



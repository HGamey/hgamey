class ClientError(Exception):
    def __init__(self, code, body):
        super().__init__(f"HTTP {code}：节点请求被拒绝或未确认")
        self.code, self.body = code, body


EXPORT_ERRORS = frozenset({"export_budget_exceeded", "export_space_insufficient", "export_write_space_failed",
                           "export_storage_unavailable", "export_busy"})


def response_error_code(body):
    try:
        value = json.loads(body)
    except (ValueError, TypeError):
        return None
    return value.get("code") if isinstance(value, dict) and isinstance(value.get("code"), str) else None


def call(method, path, data=None, headers=None, timeout=60, attempts=5, raise_4xx=False, raise_errors=False, stop_error_codes=()):
    if TARGET is None:
        raise TargetError("target_unconfigured", "需先显式配置连接目标")
    if method == "GET" and path == "/node":
        return json.dumps(TARGET.identity()).encode()
    request = TARGET.request(method, path, data, headers)
    for attempt in range(attempts):
        try:
            with TARGET.opener.open(request, timeout=timeout) as r:
                return r.read()
        except urllib.error.HTTPError as e:
            if e.code < 500 or raise_errors or stop_error_codes:
                with e:
                    body = e.read((1 << 20) + 1)
                stop = response_error_code(body) in stop_error_codes
                if raise_errors or stop or (e.code < 500 and raise_4xx):
                    raise ClientError(e.code, body)
                if e.code < 500:
                    sys.exit(f"pf-node: HTTP {e.code}，请求被拒绝；未跟随重定向")
            err = e
        # http.client.IncompleteRead 等（经 Cloudflare 读到一半断流）也重试
        except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as e:
            if raise_errors:
                raise
            err = e
        if attempt + 1 < attempts:
            print(f"pf-node: {method} {path.split('?')[0]} 出错 {err!r}，{min(2 ** attempt, 30)}s 后重试", file=sys.stderr)
            time.sleep(min(2 ** attempt, 30))
    sys.exit(f"pf-node: 连不上节点 {URL}: {err!r}")


def pack(argv):
    """把参数里的本地路径打进 tar，参数改写成 @in/<序号>/<basename>。"""
    buf, n, out = io.BytesIO(), 0, []
    with gzip.GzipFile(fileobj=buf, mode="wb", mtime=0) as gz, tarfile.open(fileobj=gz, mode="w") as t:
        for a in argv:
            flag, sep, val = a.partition("=") if a.startswith("--") and "=" in a else ("", "", a)
            if val and not val.startswith("@") and os.path.exists(val):
                arc = f"{n}/{os.path.basename(os.path.normpath(val))}"
                t.add(val, arcname=arc)
                n += 1
                val = f"@in/{arc}"
            out.append(f"{flag}{sep}{val}" if sep else val)
    return out, (buf.getvalue() if n else b"")


def valid_request_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}", value):
        sys.exit("pf-node: request_id 须为 1–128 位，以字母或数字开头，只含字母、数字、点、下划线、冒号和连字符")
    return value


def device_binding_envelope(value, node_id):
    if not isinstance(node_id, str) or not node_id or not isinstance(value, dict) or value.get("node_id") != node_id:
        raise ValueError("设备绑定文件 node_id 与当前固定节点不一致")
    binding = value.get("binding")
    if (not isinstance(binding, dict) or set(binding) != {"schema", "domain_id", "registry_revision", "device_id", "serial"}
            or binding.get("schema") != "phonefarm/device-binding@1"
            or not isinstance(binding.get("domain_id"), str) or not re.fullmatch(r"[0-9a-f]{32}", binding["domain_id"])
            or type(binding.get("registry_revision")) is not int or not 0 < binding["registry_revision"] <= 2**53 - 1
            or not isinstance(binding.get("device_id"), str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", binding["device_id"])
            or not isinstance(binding.get("serial"), str) or not binding["serial"]
            or len(binding["serial"].encode()) > 256 or any(c.isspace() or ord(c) < 32 or ord(c) == 127 for c in binding["serial"])
            or len(json.dumps(binding).encode()) > 4096):
        raise ValueError("设备绑定须为 devices-resolve 返回的完整 device-binding@1 对象")
    return binding


def require_idempotent_jobs(require_recovery=False, execution_policy=None, inputs=None, device_binding=None, time_budget=None, host_slots=None, disk_guard=None, priority=None):
    TARGET.require_write()
    try:
        node = json.loads(call("GET", "/node", attempts=1, raise_4xx=True))
    except ClientError as e:
        if e.code == 404:
            sys.exit("pf-node: 节点不支持幂等任务提交，请升级节点服务；未发送 POST /jobs")
        sys.exit(f"pf-node: 无法确认节点提交能力：{e}；未发送 POST /jobs")
    if "jobs.idempotency-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.idempotency-v1，请升级节点服务；未发送 POST /jobs")
    if require_recovery and "jobs.recovery-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.recovery-v1，不能显式指定设备访问或恢复任务；请升级节点服务；未发送 POST /jobs")
    if execution_policy is not None:
        if "jobs.execution-policy-v1" not in node.get("capabilities", []):
            sys.exit("pf-node: 节点未提供 jobs.execution-policy-v1，无法确认执行策略；未打包或提交")
        capability = node.get("execution", {}).get("process_policies", {}).get(execution_policy, {})
        if capability.get("available") is not True:
            sys.exit(f"pf-node: 执行策略 {execution_policy} 不可用：{capability.get('reason') or '节点未提供能力证据'}；未打包或提交")
    if priority is not None and "jobs.priority-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.priority-v1；未提交，不丢弃显式优先级")
    if host_slots is not None and "jobs.host-capacity-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.host-capacity-v1；未打包或提交，不删除显式需求降级")
    if time_budget is not None and "jobs.time-budget-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.time-budget-v1；未打包或提交，不删除原预算降级")
    if disk_guard is not None and "jobs.disk-guard-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.disk-guard-v1；未打包或提交，不删除原磁盘声明降级")
    if inputs is not None:
        if "jobs.inputs-v1" not in node.get("capabilities", []):
            sys.exit("pf-node: 节点缺少 jobs.inputs-v1；未打包或提交")
        from job_inputs import validate
        try:
            validate(inputs, node.get("node_id"))
        except ValueError as error:
            sys.exit(f"pf-node: 输入清单无效：{error}；未打包或提交")
        if any("node" in item["source"] for item in inputs["files"]):
            if "jobs.cross-node-inputs-v1" not in node.get("capabilities", []):
                sys.exit("pf-node: 节点缺少 jobs.cross-node-inputs-v1，不接受跨节点输入来源；未打包或提交")
    if device_binding is not None:
        if "devices.lanes-v1" not in node.get("capabilities", []):
            sys.exit("pf-node: 节点缺少 devices.lanes-v1；未打包或提交，不降级全域")
        try:
            device_binding_envelope(device_binding, node.get("node_id"))
        except ValueError as error:
            sys.exit(f"pf-node: {error}；未打包或提交")
    return node



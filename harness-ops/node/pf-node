#!/usr/bin/env python3
"""pf-node：在手机节点上跑 phonefarm / game_opt_loop / adb / devlock，用法和本地几乎一样。

  pf-node phonefarm eval --request r.json --json --lock-label judge
  pf-node -o ./evidence phonefarm eval --request r.json --out @out/ev
  pf-node adb -s 91253241019A shell 'su -c "cat /sys/class/kgsl/kgsl-3d0/max_pwrlevel"'
  pf-node devlock status
  pf-node --detach phonefarm autoloop ...      # stdout 只回任务 id；stderr 显示提交阶段和 request_id
  pf-node --request-id study-001 --resource device:oneplus phonefarm eval ...
  pf-node --execution-policy process_group --detach phonefarm ...
  pf-node --max-runtime-seconds 900 --timeout-action graceful --detach phonefarm ...
  pf-node --priority 5 --detach phonefarm ... # -10..10，越高越先；同级FIFO，不抢占运行任务
  pf-node --host-slots slots.json --detach phonefarm ... # {"cpu":2,"gpu":1,"io":0}
  pf-node --disk-guard guard.json --detach phonefarm ... # {"max_log_bytes":67108864,"min_free_bytes":1073741824,"stop_action":"graceful"}
  pf-node request <request_id>               # 断网后找回同一次提交的任务
  pf-node update-status [--json]             # 只读维护状态；不提交更新或重启
  pf-node doctor [--json]                    # 绑定节点的只读宿主诊断；不探测设备
  pf-node queue                              # 只读持久队列快照
  pf-node export-cache JOB_ID [--clear]       # 查看/显式清理该任务可再生成的目录导出缓存
  pf-node export-caches [--clear]             # 聚合查看/显式清理全部可再生成的目录导出缓存（只动缓存文件）
  pf-node export-caches --enforce-quota N     # 显式按字节配额逐出最旧缓存（可审计报告）
  pf-node admin-restart                      # 核原节点后仅发送一次服务重启请求
  pf-node leases [id]                        # 只读全局屏障或指定任务的 lease 收据
  pf-node session-status <id> [--request-id ID] [--json] # 只读灰层会话或动作回执
  pf-node session-recovery <id>             # 只读原会话来源、阻断叶子与恢复尝试计划
  pf-node session-action <id> --request FILE|- # 提交完整动作 JSON；不会自动重发
  pf-node session-recover <id> [--request-id ID] # 根据原任务绑定创建异步恢复任务，不等待完成
  pf-node execution-reconcile <id> [--force]   # 异步核查原任务绑定域；force会结束域内残留进程
  pf-node --detach phonefarm gray-layer session --serial SERIAL --package com.example.game --mode frameaudit --out @out --max-seconds 900 --power-policy battery
  pf-node --detach phonefarm gray-layer refbench-loadop --serial SERIAL --frames 1800 --intensity 8 --timeout-seconds 150 --out @out --json
  pf-node --device-access recovery --recovery-for <id> phonefarm <明确的恢复命令>
  pf-node release <id> --note "核查结果"      # 管理员核查后允许再次调度，不代表设备已恢复
  pf-node retry-finalize <id>                # 重试保存原有结束记录，不重新执行命令
  pf-node --exe src/target/release/phonefarm phonefarm eval ...   # 用自己分支编译的可执行（节点上仍在 phonefarm 根目录下跑）
  pf-node status|log|wait|kill|out <id>
  pf-node cancel <id> [--force]            # 默认请求 SIGINT；--force 允许 15s 后 TERM、再 15s 后 KILL
  pf-node node [--refresh-runtime]        # 服务启动观察、配置程序身份；显式刷新不改历史job
  pf-node devices                       # 本节点人工登记的稳定设备ID/连接别名；不探测设备
  pf-node devices-set FILE|-             # CAS登记/更新；写入未知先读devices，不自动重发
  pf-node devices-resolve SERIAL         # 纯宿主核对精确别名，输出 {node_id,binding} 可保存为文件
  pf-node --device-binding binding.json --detach phonefarm gray-layer session --serial SERIAL ...
  pf-node fleet [--wait N]                 # 只读设备/锁快照，最多等待 N 秒刷新（缺省 5）
  pf-node live status SERIAL [--device-binding FILE] # 单次读取看屏状态
  pf-node live frame SERIAL --output FILE [--device-binding FILE] # 单次JPEG；原绑定、显式新文件、不重试
  pf-node jobs [--query TEXT] [--state running|finished|lost] [--limit N] [--cursor C]
  pf-node job-sources                     # 管理员登记的只读历史来源与 revision
  pf-node jobs --source old-local --source-revision 1 [--query TEXT] [--limit N] [--cursor C]
  pf-node status|log|artifacts <id> --source old-local --source-revision 1
  pf-node out <id> <file-path> --source old-local --source-revision 1
  pf-node job-events [--job ID] [--cursor C|--after N] [--limit N] # 单次读取已提交事件，需显式节点 ID
  pf-node artifacts <id> [--path DIR] [--limit N] [--cursor C]
  pf-node input-reference <id> <path>       # 显式校验一个已收尾任务的小工件，返回同节点输入引用
  pf-node --inputs inputs.json --detach phonefarm ... # 冻结工件及显式JSON字段绑定后执行
  pf-node inputs <id>                      # 输入声明、准备回执与失败原因
  pf-node games list|show ID VERSION       # 本节点游戏清单、资源状态与准备历史
  pf-node games register FILE             # 仅登记 JSON 清单，不上传其中引用的大文件
  pf-node games prepare ID VERSION [--request-id ID] # 异步准备宿主资源，不安装或启动游戏
  pf-node games request REQUEST_ID        # 找回同一次准备任务，不自动重发
  pf-node games deploy ID VERSION --serial S [--device-binding FILE] [--check] [--request-id ID] # 新目录资源部署；check只读设备前提
  pf-node games install ID VERSION --serial S [--device-binding FILE] [--check] [--request-id ID] # 明确缺席的单APK新装；check只读
  pf-node games initialize ID VERSION --serial S [--device-binding FILE] [--check] [--request-id ID] # 有界Launcher初始化尝试与停止；check只读
  pf-node games scene ID VERSION --serial S --deployment-inputs FILE [--device-binding FILE] [--check] [--request-id ID]
  # games 的 --device-binding 放在子命令后，读取 devices-resolve 的 {node_id,binding} 文件；缺省全域，恢复继承原范围。
  pf-node games deployment JOB_ID         # 原部署报告、事实与恢复范围
  pf-node games assistance-draft JOB --research ID --direction ID # 只读起草现有协助请求 data
  pf-node games deployment-recover JOB_ID --request-id ID # 接续原上下文，不重放部署
  pf-node games upload ID VERSION ASSET FILE [--upload-id ID] # 分块上传；原ID显式续传，不打包/本机hash
  pf-node games upload-status ID          # 原上传的持久offset、缓存事实与校验任务
  pf-node games upload-finalize ID        # 字节收齐后提交/找回同一个校验任务
  pf-node games upload-cancel ID          # 取消写入保留，保留partial与历史
  pf-node results list|show ID             # 显式登记结果索引与来源；不扫描旧任务目录
  pf-node results search --node NAME [--node OTHER] # 只读搜索已绑定节点，各节点独立分页
  pf-node results compare FILE             # 显式2–4列指标矩阵；只读登记值差，保留未知与来源
  pf-node results register FILE            # 不可变登记；固定 result_id，回执未知仅查询原 ID
  pf-node results import FILE --adapter NAME [--import-id ID] # 仅导入小 JSON，保留原字节
  pf-node results import-status ID         # 找回原导入及全部派生结果
  pf-node research list|show|history ...    # 持久研究、方向、协助请求与反馈，共享版本历史
  pf-node research assess ID --revision N  # 显式pin/判据能力；只读指定版本，partial退出2，规则未知保留
  pf-node research create KIND ID FILE     # 仅登记 data JSON；写前固定 operation ID
  pf-node research update KIND ID FILE --revision N --reason TEXT # 显式并发更新，不自动合并
  pf-node research operation ID            # 原元数据操作回执；未知时不自动重发
  pf-node research events [--after N | --cursor CURSOR] [--wait-seconds 0..15] # 单次读取/有界等待，不自动翻页或确认消费
  pf-node research media REQUEST A|B --revision N --output FILE # 显式原件下载，核长度/SHA且不覆盖
  pf-node out <id> <相对路径>          # 只下输出目录里的一个文件（或子目录）

- 参数里凡是本机存在的文件/目录（含 --flag=路径 的写法）自动打包上传，在节点上替换成对应路径。
- @out 是本次任务在节点上的输出目录；任务结束后它的内容下载到 -o 指定的目录（缺省 ./pf-node-out/<id>）。
  下载分块进行（PF_NODE_CHUNK 字节一块，缺省 2MB），断了自动续，最后校验 sha256；中途中断的进度存在
  <目标目录的上级>/.pf-node-<id>-*.part，再跑一次 `pf-node out <id>` 接着下。
- 目录导出先单次请求元数据；jobs.export-limits-v1 节点的政策见 node.execution.export_limits。
  export_budget_exceeded/export_space_insufficient/export_write_space_failed/export_storage_unavailable/export_busy
  会保留原JSON原因及已有本地partial，不自动重新压缩或转为旧节点二进制下载；busy不当源变化。
  预算超限时可显式选择较小子目录或原文件；空间检查不是预留或全节点缓存配额。旧节点政策未知。
  `pf-node node` 的 storage.export_cache 原样报告目录缓存模式、配置/有效根和启动打开状态；
  jobs.export-cache-root-v1 的 available 不保证当前空间。外置根不可用不退回旧根；不迁移/清理旧缓存，单文件下载不依赖它。
- --inputs 指定 phonefarm/job-inputs@1 小清单：同节点已收尾工件，每份最多8MiB、合计32MiB。
  显式JSON pointer绑定生成独立文件，源字节保留；不猜改脚本文字。脚本可用已有PF_JOB_IN，
  或在清单中选cwd=input。准备失败未启动命令；同request_id保持原结果，修好后显式用新ID。
- jobs.input-limits-v1 节点限制输入准备：压缩归档512MiB、展开文件payload512MiB、tar流544MiB、
  4096项、可用空间至少保留64MiB；用 node 查看 execution.input_limits 的服务端策略。
  metadata_bytes 为单个 PAX/GNU 扩展记录的声明大小上限1MiB，总元数据仍受完整流和记录数限制。
  归档只接受普通file/dir，拒绝链接/特殊/sparse；tar文件、工件原件与实际派生JSON共用展开payload上限。
  status <id> 的 input_preparation 保留准备状态、部分写入字节、空间预检与失败详情；旧null不是0字节。
  written_bytes 只计成功返回的write，异常可能留未计入partial，不是磁盘实际占用；空间预检不是运行期配额。
  准备失败保留job/request ID，原ID不重准备，
  修正输入后显式新请求。服务端权威检查；客户端不额外改归档字节/指纹或据当前限值阻断旧ID查询。
- 日志实时回显；已知退出码沿用节点命令，未知退出码用 125。Ctrl-C 只请求柔性 SIGINT 并停止本地跟随（130）；
  独立 worker 继续收尾，取消请求不代表设备已恢复。cancel/kill 需要管理 token；旧 kill 保留强制升级语义。
- 新建 phonefarm gray-layer session 需 node.protocol-compat-v1 且配置 PF 的 gray_control compatible；禁止 --exe。
  不按 SHA 猜兼容，不自动刷新程序或重试。已给 request_id 时先单次查回，再以原 ID 提交核同内容；不同内容仍冲突。
  已记录请求不受当前新建兼容门禁影响；旧 status/action/stop/recovery 不受此门禁影响。
- 每次提交生成 request_id；同一次重试保持请求内容和 id 不变。--request-id 可手动指定，--resource 可重复声明独占资源。
  preparing/queued 只代表准备或排队；提交前需节点支持幂等请求，结果未知时用 request 查询，不要换 id 重投。
- --host-slots FILE 读取最多4KiB闭合三键JSON：cpu=1..65535、gpu/io=0..65535整数。
  这是声明调度slots，不是硬件数量或OS限额；0表示未预留。省略保持原spec，调度兼容CPU1/GPU0/I/O0。
  恢复任务暂不接受显式slots；未知宿主保留和设备恢复屏障分别核查，不自动释放或缩减需求。
- --max-runtime-seconds N 声明 1–604800 整数秒运行期限；--timeout-action graceful（默认）或 escalate。
  仅实际启动后计时，排队不计入；graceful只请求SIGINT，escalate沿15秒TERM/再15秒KILL。
  恢复任务暂不支持；期限触发不代表已停止/恢复。原exit=0且确认超期限时CLI返回124，未知结束优先125。
- --disk-guard FILE 读取最多4KiB闭合JSON：max_log_bytes/min_free_bytes 均为1–9007199254740991的整数字节，
  stop_action=graceful|escalate；缺省不发送，恢复任务不支持。需节点 jobs.disk-guard-v1，不删除原声明降级。
  启动前核查，运行中最多每秒观察一次；日志达到上限、共享空间低于下限或观察失败时请求停止。
  这是软阈值，不截断/删除原件，不是任意输出硬配额；日志逻辑长度不是磁盘实际占用，空间不归因当前作业。
  status 的 execution.disk_guard 只表示最后成功保存的观察，未知不补零；观察触发、实际信号、退出和恢复分开。
  已知日志/空间阈值触发且可信exit=0返回124；未知/中断125优先，真实非零退出码保留；启动前拒绝不造退出码。
- status 的 execution.stop_intent 是 worker 最后成功保存的停止原因和管理记录错误历史，可能落后于实际执行。
  实际已发信号仍看 cancel.signals；这些记录不证明已停/已恢复，也不表示当前磁盘剩余量。
  owner_record_error 独立发起停止时，即使命令exit=0仍按interrupted返回125；期限124规则保持。
- --execution-policy process_group|contained 显式要求进程管理范围；先核节点能力，不支持时不打包/提交。
  process_group 只管理原进程组；contained 当前未提供。省略保留兼容默认，不替旧任务补全树结束证明。
- finalizing 表示结束记录尚在保存；storage_blocked 表示保存失败，wait/跟随以125退出并保留命令诊断。
  修复存储后用 retry-finalize；它只重新同步原有记录，返回 storage_committed 不代表设备恢复或资源已释放。
- 历史 --source 与 --source-revision 必须同时显式提供，只用于 jobs/status/log/artifacts/out；
  不支持 wait/kill/恢复或写入。来源变化保留原 revision 并报错，不自动选择新目录或退回当前作业。
  历史 out 仅单文件；默认写到 pf-node-out/SOURCE/revision-N/JOB，下载 partial 绑定节点/来源/revision/job。
  原 running/exit 只作为历史记录显示，不推断当前进程、实验成功或设备恢复；不向历史根写缓存或归档。
- job-events 每次只读取一页（limit 1–200），不等待、不自动重试/分页或确认消费；失败保留原 cursor。
  status_revision 仅覆盖 Node 的 committed_status，不能据相同版本推断 worker、lease、日志或控制资格未变。
  事件不是无损执行历史；head 不是已处理位置，消费者处理后自行保存 next_cursor。Ctrl-C 不取消任务。
- --device-access none|write|recovery 显式声明设备访问；recovery 必须配 --recovery-for 原资源保留任务 ID，
  资源由父任务继承，不能同时传 --resource。恢复任务不自动解除原屏障；核查后另行 release。
- --device-binding FILE 只读 devices-resolve 保存的 JSON 文件，核其 node_id 与当前目标；只将 binding 放入 job spec，
  不自行给 argv 注入参数。仅配置 phonefarm 的 gray-layer session 支持，禁止 --exe 和 none/recovery 覆盖；
  缺省不发送字段，保持兼容全域。登记/布局变化明确拒绝，不换 alias、不自动降级；typed 恢复继承原绑定。
- 当前场景采样沿 session-action：动作 JSON 的 action="sample"、params={"seconds":30}（整数1–120）；
  需会话 allowed_actions 提供 sample，匹配 controller/epoch。accepted 不是采集完成，用原 ID 查询回执。
  params 可选 render_comm（1–64 UTF-8 字节、无控制字符）；不选线程仍收集原件，帧相关指标保持未知。
  默认无输入；仅 action_capabilities.sample=2 的会话支持 params.input 数组/仅steps对象 + frame_id。
  例如 seconds=3、input=[{"action":"sleep","ms":6000},{"action":"tap","x":80,"y":100},{"action":"sleep","ms":7000}]。
  frame_id 须引用最新且30秒内、方向已知的原图；不自动截图。声明计划至少 seconds+10 秒、最多600秒。
  输入自然完成、采集完成和设备恢复分别核对；结果未知仍用原请求 ID 查询，不自动重发。
  GPU submit proxy 不是显示 FPS；游戏 energy_per_frame_mj 仍为 null。
- session-status --json 成功仍输出原始 JSON；失败非0，stdout JSON 含 error.code、error.message 与 http_status（整数或null）。
  只查询一次，保留服务端错误码；泛404不是 not_found，网络错误为 network_error，不代表请求未提交。
- session-recover 由节点绑定原会话与设备，不接收路径。提交前打印 request_id；超时后用 request 查询，
  或 session-recover 原任务 --request-id 原ID 重试，不换 ID 重复创建。新任务仍需核查恢复结果与原资源保留。
- session-recovery 只读恢复链计划，需 jobs.session-recovery-chain-v1；eligible=false 也是有效计划。
  session-recover 不自动切换叶子；409 时先查计划，原 request_id 始终绑定原入口。
  原 session 来源与 recovery_for 队列父分别核对；限定恢复成功仍须审收据并由叶子向祖先显式 release。
- execution-reconcile 只核查原任务绑定域，不重放命令、不新建实验任务；普通核查不杀进程。
  --force 明确允许结束域内残留进程，再核查域空与输出交还。只POST一次，超时仅用 status 原任务核对，
  不自动重发或等待。complete仅为宿主收尾，不代表设备恢复、队列释放，原失联/失败事实保留。
- 画质检查点沿 session-action，需 action_capabilities.quality=1 与当前 controller/epoch：
  {"schema":"phonefarm/gray-control-action@1","request_id":"quality-begin-1","session_id":"SESSION",
   "actor_id":"agent","control_epoch":1,"action":"quality","params":{"op":"begin","label":"scene-dusk-01"}}
  同标签依次 begin/checkpoint/finish；每次明确操作使用独立请求 ID，未知结果仍查询原 ID，不自动重发。
  label 为1–64位ASCII字母、数字、下划线或短横线；不自动导航。latest_quality 可跨客户端读取共享阶段和原件。
  collected 只表示证据齐全，不代表同场景/画质通过/设备恢复；原图和派生半尺寸预览分别保留。
- gray-layer session --power-policy observe|battery 在创建时固定，默认 observe；observe 不请求改变充电控制。
  battery 在首次 sample 准备，跨轮保持，最终 stop/recover 还原绑定原值；选择策略不代表已经放电或功耗合格。
  whole-sampler 平均功率与 trace 窗口积分估计分别记录；后者可用性由同期电池样本与窗口资格决定，缺失为未知。
  trace_energy_j/trace_power_w_mean 是采样积分估计，不是游戏每帧能耗；旧 producer 可能在设备操作前拒绝新参数。
  新 producer 的 gpu_submit_group_window_energy_j / gpu_submit_group_window_power_w_mean 取完整提交组同窗积分，
  battery_energy_per_gpu_submit_group_mj 是整机电池窗口平均每组估计，非逐组测量或游戏每帧能耗。
  原 JSON 的 metric_provenance.submit_group_energy 给出窗口、组数、供电/时钟/损失资格；旧记录缺字段保持未知。
- 目标须显式 --url URL / PF_NODE_URL；写入须 --node-id ID / PF_NODE_ID，可先用 node 只读取得。
- 凭据只用 --token-file FILE 或 PF_NODE_TOKEN / PF_NODE_TOKEN_FILE；显式文件优先，两种环境凭据冲突即拒绝。

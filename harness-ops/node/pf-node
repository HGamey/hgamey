        from result_client import HELP
        print(HELP)
        return
    if args[0] == "research" and (len(args) == 1 or any(arg in ("--help", "-h") for arg in args[1:])):
        from research_client import HELP
        print(HELP)
        return
    if len(args) >= 2 and args[0] == "research" and args[1] in ("plan-template", "recipes"):
        from research_client import main as research_main
        return research_main(args[1:], target=None)
    try:
        TARGET = Target.resolve(connection_url, expected_node_id, explicit_file)
    except TargetError as error:
        if args[0] in ("doctor", "update-status") and args[1:] == ["--json"]:
            print(json.dumps({"error": {"code": error.code, "message": str(error)}, "http_status": None}, ensure_ascii=False))
            raise SystemExit(1)
        raise
    URL, TOKEN = TARGET.url, TARGET.token
    if args[0] in ("doctor", "update-status"):
        if (request_id is not None or inputs_path is not None or resources or device_access is not None
                or recovery_for is not None or execution_policy is not None or time_budget is not None
                or host_slots_path is not None or disk_guard_path is not None or priority is not None or binding_path is not None or exe or detach or outdir):
            sys.exit("pf-node: " + args[0] + " 不接收作业选项；这是单次只读请求")

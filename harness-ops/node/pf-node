                or recovery_for is not None or execution_policy is not None or time_budget is not None
                or host_slots_path is not None or disk_guard_path is not None or priority is not None or binding_path is not None or exe or detach or outdir):
            sys.exit("pf-node: live 不接收作业选项；--device-binding 放在 live 子命令后")
        from live_client import main as live_main
        return live_main(TARGET, args[1:])
    history_commands = ("jobs", "status", "log", "artifacts", "out", "wait", "kill", "cancel", "release", "session-recover", "retry-finalize")
    if args[0] == "job-sources" or (args[0] in history_commands and any(value in ("--source", "--source-revision") for value in args[1:])):
        if (request_id is not None or inputs_path is not None or resources or device_access is not None
                or recovery_for is not None or execution_policy is not None or time_budget is not None
                or host_slots_path is not None or disk_guard_path is not None or priority is not None or binding_path is not None or exe or detach):
            sys.exit("pf-node: 历史来源读取不接收作业提交/控制选项")

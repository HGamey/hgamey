#!/usr/bin/env python3
"""pf-node：在手机节点上跑 phonefarm / game_opt_loop / adb / devlock，用法和本地几乎一样。

  pf-node phonefarm eval --request r.json --json --lock-label judge
  pf-node -o ./evidence phonefarm eval --request r.json --out @out/ev
  pf-node adb -s 91253241019A shell 'su -c "cat /sys/class/kgsl/kgsl-3d0/max_pwrlevel"'
  pf-node devlock status
  pf-node --detach phonefarm autoloop ...      # stdout 只回任务 id；stderr 显示提交阶段和 request_id
  pf-node --request-id study-001 --resource device:oneplus phonefarm eval ...
  pf-node request <request_id>               # 断网后找回同一次提交的任务
  pf-node queue                              # 只读持久队列快照
  pf-node leases [id]                        # 只读全局屏障或指定任务的 lease 收据
  pf-node session-status <id> [--request-id ID] # 只读灰层会话或动作回执
  pf-node session-action <id> --request FILE|- # 提交完整动作 JSON；不会自动重发
  pf-node --detach phonefarm gray-layer session --serial SERIAL --package com.example.game --mode frameaudit --out @out --max-seconds 900 --power-policy battery
  pf-node --device-access recovery --recovery-for <id> phonefarm <明确的恢复命令>
  pf-node release <id> --note "核查结果"      # 管理员核查后允许再次调度，不代表设备已恢复
  pf-node --exe src/target/release/phonefarm phonefarm eval ...   # 用自己分支编译的可执行（节点上仍在 phonefarm 根目录下跑）
  pf-node status|log|wait|kill|out <id>
  pf-node cancel <id> [--force]            # 默认请求 SIGINT；--force 允许 15s 后 TERM、再 15s 后 KILL
  pf-node node                            # 执行宿主、持久节点身份、数据位置、服务版本
  pf-node fleet [--wait N]                 # 只读设备/锁快照，最多等待 N 秒刷新（缺省 5）
  pf-node jobs [--query TEXT] [--state running|finished|lost] [--limit N] [--cursor C]
  pf-node artifacts <id> [--path DIR] [--limit N] [--cursor C]
  pf-node out <id> <相对路径>          # 只下输出目录里的一个文件（或子目录）

- 参数里凡是本机存在的文件/目录（含 --flag=路径 的写法）自动打包上传，在节点上替换成对应路径。
- @out 是本次任务在节点上的输出目录；任务结束后它的内容下载到 -o 指定的目录（缺省 ./pf-node-out/<id>）。
  下载分块进行（PF_NODE_CHUNK 字节一块，缺省 2MB），断了自动续，最后校验 sha256；中途中断的进度存在
  <目标目录的上级>/.pf-node-<id>-*.part，再跑一次 `pf-node out <id>` 接着下。
- 日志实时回显；已知退出码沿用节点命令，未知退出码用 125。Ctrl-C 只请求柔性 SIGINT 并停止本地跟随（130）；
  独立 worker 继续收尾，取消请求不代表设备已恢复。cancel/kill 需要管理 token；旧 kill 保留强制升级语义。
- 每次提交生成 request_id；同一次重试保持请求内容和 id 不变。--request-id 可手动指定，--resource 可重复声明独占资源。
  preparing/queued 只代表准备或排队；提交前需节点支持幂等请求，结果未知时用 request 查询，不要换 id 重投。
- --device-access none|write|recovery 显式声明设备访问；recovery 必须配 --recovery-for 原资源保留任务 ID，
  资源由父任务继承，不能同时传 --resource。恢复任务不自动解除原屏障；核查后另行 release。
- 当前场景采样沿 session-action：动作 JSON 的 action="sample"、params={"seconds":30}（整数1–120）；
  需会话 allowed_actions 提供 sample，匹配 controller/epoch。accepted 不是采集完成，用原 ID 查询回执。
  params 可选 render_comm（1–64 UTF-8 字节、无控制字符）；不选线程仍收集原件，帧相关指标保持未知。
  默认无输入；仅 action_capabilities.sample=2 的会话支持 params.input 数组/仅steps对象 + frame_id。
  例如 seconds=3、input=[{"action":"sleep","ms":6000},{"action":"tap","x":80,"y":100},{"action":"sleep","ms":7000}]。
  frame_id 须引用最新且30秒内、方向已知的原图；不自动截图。声明计划至少 seconds+10 秒、最多600秒。
  输入自然完成、采集完成和设备恢复分别核对；结果未知仍用原请求 ID 查询，不自动重发。
  GPU submit proxy 不是显示 FPS；此批不计算每帧能耗。
- 画质检查点沿 session-action，需 action_capabilities.quality=1 与当前 controller/epoch：
  {"schema":"phonefarm/gray-control-action@1","request_id":"quality-begin-1","session_id":"SESSION",
   "actor_id":"agent","control_epoch":1,"action":"quality","params":{"op":"begin","label":"scene-dusk-01"}}
  同标签依次 begin/checkpoint/finish；每次明确操作使用独立请求 ID，未知结果仍查询原 ID，不自动重发。
  label 为1–64位ASCII字母、数字、下划线或短横线；不自动导航。latest_quality 可跨客户端读取共享阶段和原件。
  collected 只表示证据齐全，不代表同场景/画质通过/设备恢复；原图和派生半尺寸预览分别保留。
- gray-layer session --power-policy observe|battery 在创建时固定，默认 observe；observe 不请求改变充电控制。
  battery 在首次 sample 准备，跨轮保持，最终 stop/recover 还原绑定原值；选择策略不代表已经放电或功耗合格。
  whole-sampler 平均功率与 trace 窗口积分估计分别记录；后者可用性由同期电池样本与窗口资格决定，缺失为未知。
  trace_energy_j/trace_power_w_mean 是采样积分估计，不是游戏每帧能耗；旧 producer 可能在设备操作前拒绝新参数。
- 节点地址 PF_NODE_URL（缺省 https://mbp1.liyao.space，主力节点），token 依次找 PF_NODE_TOKEN、PF_NODE_TOKEN_FILE、<工作根目录>/.hgamey/node.token。
"""
import gzip, hashlib, http.client, io, json, math, os, re, sys, tarfile, time, urllib.error, urllib.parse, urllib.request, uuid

URL = os.environ.get("PF_NODE_URL", "https://mbp1.liyao.space").rstrip("/")
def _token():
    """token 查找顺序：PF_NODE_TOKEN → PF_NODE_TOKEN_FILE → 从本脚本所在目录（链接位置和真实位置都试）
    逐级往上找 .hgamey/node.token → 旧位置 ~/.config/hgamey。"""
    if os.environ.get("PF_NODE_TOKEN"):
        return os.environ["PF_NODE_TOKEN"]
    cands = [os.environ.get("PF_NODE_TOKEN_FILE")]
    for start in (os.path.dirname(os.path.abspath(sys.argv[0])), os.path.dirname(os.path.realpath(__file__))):
        d = start
        while True:
            cands.append(os.path.join(d, ".hgamey", "node.token"))
            parent = os.path.dirname(d)
            if parent == d:
                break
            d = parent
    cands.append(os.path.expanduser("~/.config/hgamey/node.token"))
    for f in cands:
        if f and os.path.isfile(f):
            return open(f).read().strip()
    sys.exit("pf-node: 找不到节点 token（PF_NODE_TOKEN / PF_NODE_TOKEN_FILE / 上级目录里的 .hgamey/node.token）")


TOKEN = _token()
CHUNK = int(os.environ.get("PF_NODE_CHUNK", 2 << 20))


class ClientError(Exception):
    def __init__(self, code, body):
        super().__init__(f"{code} {body.decode(errors='replace')}")
        self.code, self.body = code, body


def call(method, path, data=None, headers=None, timeout=60, attempts=5, raise_4xx=False):
    h = {"Authorization": f"Bearer {TOKEN}", "User-Agent": "pf-node/1", **(headers or {})}
    for attempt in range(attempts):
        try:
            with urllib.request.urlopen(urllib.request.Request(URL + path, data=data, method=method, headers=h), timeout=timeout) as r:
                return r.read()
        except urllib.error.HTTPError as e:
            if e.code < 500:
                with e:
                    body = e.read()
                if raise_4xx:
                    raise ClientError(e.code, body)
                sys.exit(f"pf-node: {e.code} {body.decode(errors='replace')}")
            err = e
        # http.client.IncompleteRead 等（经 Cloudflare 读到一半断流）也重试
        except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as e:
            err = e
        if attempt + 1 < attempts:
            print(f"pf-node: {method} {path.split('?')[0]} 出错 {err!r}，{min(2 ** attempt, 30)}s 后重试", file=sys.stderr)
            time.sleep(min(2 ** attempt, 30))
    sys.exit(f"pf-node: 连不上节点 {URL}: {err!r}")


def pack(argv):
    """把参数里的本地路径打进 tar，参数改写成 @in/<序号>/<basename>。"""
    buf, n, out = io.BytesIO(), 0, []
    with gzip.GzipFile(fileobj=buf, mode="wb", mtime=0) as gz, tarfile.open(fileobj=gz, mode="w") as t:
        for a in argv:
            flag, sep, val = a.partition("=") if a.startswith("--") and "=" in a else ("", "", a)
            if val and not val.startswith("@") and os.path.exists(val):
                arc = f"{n}/{os.path.basename(os.path.normpath(val))}"
                t.add(val, arcname=arc)
                n += 1
                val = f"@in/{arc}"
            out.append(f"{flag}{sep}{val}" if sep else val)
    return out, (buf.getvalue() if n else b"")


def valid_request_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}", value):
        sys.exit("pf-node: request_id 须为 1–128 位，以字母或数字开头，只含字母、数字、点、下划线、冒号和连字符")
    return value


def require_idempotent_jobs(require_recovery=False):
    try:
        node = json.loads(call("GET", "/node", attempts=1, raise_4xx=True))
    except ClientError as e:
        if e.code == 404:
            sys.exit("pf-node: 节点不支持幂等任务提交，请升级节点服务；未发送 POST /jobs")
        sys.exit(f"pf-node: 无法确认节点提交能力：{e}；未发送 POST /jobs")
    if "jobs.idempotency-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.idempotency-v1，请升级节点服务；未发送 POST /jobs")
    if require_recovery and "jobs.recovery-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.recovery-v1，不能显式指定设备访问或恢复任务；请升级节点服务；未发送 POST /jobs")


def submit_job(spec, body, request_id):
    print(f"pf-node: 提交 request_id={request_id}；结果未知时用 pf-node request {request_id} 找回任务。",
          file=sys.stderr, flush=True)
    headers = {"X-Job": json.dumps(spec, ensure_ascii=True), "X-Request-ID": request_id,
               "Content-Type": "application/gzip"}
    try:
        meta = json.loads(call("POST", "/jobs", body, headers, timeout=600, raise_4xx=True))
        meta["id"]  # A malformed response cannot confirm which job was accepted.
        return meta
    except ClientError as e:
        if e.code == 409:
            sys.exit(f"pf-node: 提交条件冲突（HTTP 409），request_id={request_id}；服务端原因："
                     f"{e.body.decode(errors='replace')}；请用 pf-node request {request_id} 核对已有任务，"
                     "并检查恢复目标条件；不要换 request_id 盲目重投。")
        sys.exit(f"pf-node: 提交被拒绝，request_id={request_id}：{e}")
    except (SystemExit, ValueError, KeyError, KeyboardInterrupt) as e:
        print(f"pf-node: 提交结果未知，request_id={request_id}：{e}；"
              f"请用 pf-node request {request_id} 查询；不要换 request_id 重复提交。", file=sys.stderr)
        raise SystemExit(130 if isinstance(e, KeyboardInterrupt) else 1)


def cancel_job(jid, force=False):
    if force:
        print("pf-node: 强制取消将请求 SIGINT，15 秒后可升级 TERM，再 15 秒后可升级 KILL；可能打断恢复。",
              file=sys.stderr)
    try:
        result = json.loads(call("POST", f"/jobs/{jid}/cancel", json.dumps({"force": force}).encode(),
                                 {"Content-Type": "application/json"}, attempts=1, raise_4xx=True))
    except ClientError as e:
        if e.code in (401, 403):
            sys.exit("pf-node: 取消请求被拒绝；需要有效的管理 token（只读 token 不能取消任务）")
        if e.code == 404:
            sys.exit("pf-node: 取消请求被拒绝；任务不存在或节点不支持 /cancel，请核对任务并升级节点服务")
        sys.exit(f"pf-node: 取消请求被拒绝：{e}")
    if result.get("accepted") is True:
        print(f"pf-node: 任务 {jid} 的取消请求已记录；请通过 status/wait 查看后续状态，设备恢复尚未据此确认。",
              file=sys.stderr)
    else:
        print(f"pf-node: 任务 {jid} 的取消请求被拒绝：{result.get('reason') or '未说明原因'}", file=sys.stderr)
    return result


def release_job(jid, note):
    try:
        result = json.loads(call("POST", f"/jobs/{jid}/queue-release", json.dumps({"note": note}).encode(),
                                 {"Content-Type": "application/json"}, attempts=1, raise_4xx=True))
    except ClientError as e:
        if e.code in (401, 403):
            sys.exit("pf-node: 释放请求被拒绝；需要有效的管理 token")
        sys.exit(f"pf-node: 释放请求被拒绝：{e}")
    if result.get("released") is True:
        print(f"pf-node: 任务 {jid} 的核查记录已保存，已允许再次调度；这不证明设备已恢复。", file=sys.stderr)
    else:
        print(f"pf-node: 释放请求被拒绝：{result.get('reason') or '未说明原因'}", file=sys.stderr)
    return result


def terminal_exit(jid, status):
    rc = status.get("exit")
    phase = status.get("phase", status.get("state", "unknown"))
    unknown = (not isinstance(rc, int) or isinstance(rc, bool) or rc == -1
               or (phase == "interrupted" and rc == 0))
    print(f"pf-node: 任务 {jid} 记录终态 phase={phase}，outcome={status.get('outcome', '未报告')}，"
          f"recovery={status.get('recovery', '未报告')}；"
          + ("没有可信退出码，CLI 返回 125" if unknown else f"exit={rc}"), file=sys.stderr)
    return 125 if unknown else rc


def follow(jid):
    off = 0
    try:
        while True:
            chunk = call("GET", f"/jobs/{jid}/log?offset={off}")
            if chunk:
                sys.stdout.buffer.write(chunk)
                sys.stdout.flush()
                off += len(chunk)
            st = json.loads(call("GET", f"/jobs/{jid}"))
            if st["state"] == "finished":
                chunk = call("GET", f"/jobs/{jid}/log?offset={off}")
                sys.stdout.buffer.write(chunk)
                return terminal_exit(jid, st)
            time.sleep(1 if chunk else 2)
    except KeyboardInterrupt:
        try:
            cancel_job(jid)
        except SystemExit as e:
            print(f"\npf-node: 未确认取消请求：{e}", file=sys.stderr)
        print(f"pf-node: 已停止本地跟随（130）；收尾仍由节点上的独立 worker 负责。"
              f"请用 pf-node status {jid} 或 wait {jid} 确认；这不是任务终态或设备恢复证明。", file=sys.stderr)
        # Do not download a changing output directory as if this were a terminal result.
        raise SystemExit(130)


def _extract(data_or_path, dest):
    kw = {"fileobj": io.BytesIO(data_or_path)} if isinstance(data_or_path, bytes) else {"name": data_or_path}
    with tarfile.open(mode="r:gz", **kw) as t:
        members = [m for m in t.getmembers() if m.name not in (".", "./")]
        if not members:
            return False
        os.makedirs(dest, exist_ok=True)
        t.extractall(dest, members=members, filter="data")
    return True


def _sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def download_out(jid, rel, part_dir):
    """分块把 /jobs/<id>/out（或 ?path=rel）下到本地文件，断了从断点续，最后核 sha256。
    返回 (本地文件, 元信息)；节点服务是旧版（不认 meta）时返回 (bytes, None)。"""
    base = f"/jobs/{jid}/out?" + (urllib.parse.urlencode({"path": rel}) + "&" if rel else "")
    for restart in range(5):
        raw = call("GET", base + "meta=1", timeout=600)  # 节点要先打 tar.gz，大目录会久一点
        try:
            meta = json.loads(raw)
        except ValueError:
            if rel:
                print("pf-node: 节点服务是旧版，不支持只下单个文件，下了整个输出目录", file=sys.stderr)
            return raw, None
        size, etag = meta["size"], meta["etag"]
        part = os.path.join(part_dir, f".pf-node-{jid}-{etag}.part")
        os.makedirs(part_dir, exist_ok=True)
        have = os.path.getsize(part) if os.path.exists(part) else 0
        if have > size:
            os.remove(part)
            have = 0
        if have and have < size:
            print(f"pf-node: 从 {have}/{size} 字节处接着下", file=sys.stderr)
        t0, changed = time.time(), False
        with open(part, "ab") as f:
            while have < size:
                n = min(CHUNK, size - have)
                try:
                    chunk = call("GET", base + urllib.parse.urlencode({"offset": have, "length": n, "etag": etag}),
                                 timeout=120, attempts=8, raise_4xx=True)
                except ClientError as e:
                    if e.code == 409:  # 节点上输出变了（任务还在写）：从头来
                        changed = True
                        break
                    sys.exit(f"pf-node: {e}")
                if len(chunk) != n:  # 短读：不写，重拿这一块
                    print(f"pf-node: 块 {have} 只收到 {len(chunk)}/{n} 字节，重拿", file=sys.stderr)
                    continue
                f.write(chunk)
                f.flush()
                have += n
                if size > 4 * CHUNK:
                    print(f"\rpf-node: 下载 {have * 100 // size}% ({have >> 20}/{size >> 20} MB)", end="", file=sys.stderr)
        if size > 4 * CHUNK:
            print(f"  {time.time() - t0:.0f}s", file=sys.stderr)
        if changed:
            os.remove(part)
            print("pf-node: 节点上的输出在变（任务还在写？），重新下载", file=sys.stderr)
            continue
        if _sha256(part) == meta["sha256"]:
            return part, meta
        os.remove(part)
        print("pf-node: sha256 对不上，重新下载", file=sys.stderr)
    sys.exit("pf-node: 下载输出反复失败")


def fetch_out(jid, dest, rel=None):
    part_dir = os.path.dirname(os.path.abspath(dest))
    got, meta = download_out(jid, rel, part_dir)
    if meta is None:  # 旧版节点服务：整份 tar.gz
        if _extract(got, dest):
            print(f"pf-node: 输出已下载到 {dest}", file=sys.stderr)
        return
    if meta["kind"] == "file":
        out = os.path.join(dest, meta["path"])
        os.makedirs(os.path.dirname(out), exist_ok=True)
        os.replace(got, out)
        print(f"pf-node: 已下载 {out}（{meta['size']} 字节，sha256 已校验）", file=sys.stderr)
        return
    try:
        sub = os.path.join(dest, meta["path"]) if meta["path"] != "." else dest
        if _extract(got, sub):
            print(f"pf-node: 输出已下载到 {sub}（sha256 已校验）", file=sys.stderr)
    finally:
        os.remove(got)


def control_request_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", value):
        sys.exit("pf-node: 会话请求 ID 仅允许 1–64 位 ASCII 字母、数字、下划线和连字符")
    return value


def session_command(args):
    if len(args) < 2 or not re.fullmatch(r"[0-9a-f]{12}", args[1]):
        sys.exit("用法: pf-node session-status <任务 id> [--request-id ID] 或 session-action <任务 id> --request FILE|-")
    path = f"/jobs/{args[1]}/session"
    if args[0] == "session-status":
        if len(args) == 4 and args[2] == "--request-id":
            path += "/actions/" + urllib.parse.quote(control_request_id(args[3]), safe="")
        elif len(args) != 2:
            sys.exit("用法: pf-node session-status <任务 id> [--request-id ID]")
        print(call("GET", path, attempts=1).decode())
        return
    if len(args) != 4 or args[2] != "--request":
        sys.exit("用法: pf-node session-action <任务 id> --request FILE|-")
    try:
        if args[3] == "-":
            body = sys.stdin.buffer.read((64 << 10) + 1)
        else:
            with open(args[3], "rb") as source:
                body = source.read((64 << 10) + 1)
        if len(body) > 64 << 10:
            sys.exit("pf-node: 动作请求不能超过 64 KiB；未发送")
        value = json.loads(body)
        if not isinstance(value, dict) or value.get("schema") != "phonefarm/gray-control-action@1":
            sys.exit("pf-node: 需要完整 phonefarm/gray-control-action@1 请求；未发送")
        request_id = control_request_id(value.get("request_id", ""))
    except (OSError, ValueError) as error:
        sys.exit(f"pf-node: 无法读取动作 JSON：{error}")
    node = json.loads(call("GET", "/node", attempts=1))
    if "jobs.session-control-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.session-control-v1，请升级；未发送动作")
    print(f"pf-node: request_id={request_id}；仅投递一次，accepted 不是执行完成。", file=sys.stderr, flush=True)
    lookup = f"pf-node session-status {args[1]} --request-id {request_id}"
    try:
        result = json.loads(call("POST", path + "/actions", body,
                                 {"Content-Type": "application/json"}, attempts=1, timeout=15, raise_4xx=True))
        if result.get("request_id") != request_id or result.get("schema") != "phonefarm/gray-control-action-result@1":
            raise ValueError("动作回执不匹配")
    except ClientError as error:
        sys.exit(f"pf-node: 动作被拒绝：{error}；先用 {lookup} 核对，不换 ID 盲重发。")
    except (SystemExit, ValueError, AttributeError, KeyboardInterrupt) as error:
        print(f"pf-node: 动作结果未确认：{error}；请用 {lookup} 查询。不要换 ID 重复输入。", file=sys.stderr)
        raise SystemExit(130 if isinstance(error, KeyboardInterrupt) else 1)
    print(json.dumps(result, ensure_ascii=False))
    print(f"pf-node: status={result.get('status')}；用 {lookup} 读取最新回执。", file=sys.stderr)


def main():
    args, outdir, detach, label, exe = sys.argv[1:], None, False, os.environ.get("DEVLOCK_LABEL"), None
    request_id, resources = None, []
    device_access, recovery_for = None, None
    while args and args[0].startswith("-"):
        a = args.pop(0)
        if a in ("-o", "--out-dir"):
            outdir = args.pop(0)
        elif a == "--detach":
            detach = True
        elif a == "--exe":
            exe = args.pop(0)
        elif a == "--label":
            label = args.pop(0)
        elif a == "--request-id":
            if not args:
                sys.exit("pf-node: --request-id 需要一个 ID")
            request_id = valid_request_id(args.pop(0))
        elif a == "--resource":
            if not args or not args[0].strip():
                sys.exit("pf-node: --resource 需要一个独占资源名称")
            resources.append(args.pop(0))
        elif a == "--device-access":
            if not args or args[0] not in ("none", "write", "recovery"):
                sys.exit("pf-node: --device-access 必须为 none、write 或 recovery")
            value = args.pop(0)
            if device_access is not None and device_access != value:
                sys.exit("pf-node: --device-access 不能声明互相矛盾的模式")
            device_access = value
        elif a == "--recovery-for":
            if not args or not re.fullmatch(r"[0-9a-f]{12}", args[0]):
                sys.exit("pf-node: --recovery-for 需要原资源保留任务的 12 位 ID")
            value = args.pop(0)
            if recovery_for is not None and recovery_for != value:
                sys.exit("pf-node: --recovery-for 只能指定一个恢复目标")
            recovery_for = value
        elif a in ("-h", "--help"):
            sys.exit(__doc__)
        else:
            sys.exit(f"pf-node: 未知选项 {a}")
    if not args:
        sys.exit(__doc__)
    if device_access == "recovery":
        if recovery_for is None:
            sys.exit("pf-node: --device-access recovery 必须配 --recovery-for 原资源保留任务 ID")
        if resources:
            sys.exit("pf-node: 恢复任务继承父任务资源，不能同时使用 --resource")
    elif recovery_for is not None:
        sys.exit("pf-node: --recovery-for 必须与 --device-access recovery 一起使用")
    if args[0] in ("session-status", "session-action"):
        return session_command(args)
    if args[0] == "request":
        if len(args) != 2:
            sys.exit("用法: pf-node request <request_id>")
        print(call("GET", f"/requests/{valid_request_id(args[1])}").decode())
        return
    if args[0] == "leases":
        if len(args) == 1:
            path = "/leases"
        elif len(args) == 2 and re.fullmatch(r"[0-9a-f]{12}", args[1]):
            path = f"/jobs/{args[1]}/leases"
        else:
            sys.exit("用法: pf-node leases [12 位任务 id]")
        try:
            print(call("GET", path, raise_4xx=True).decode())
        except ClientError as e:
            if e.code == 404:
                sys.exit("pf-node: 任务不存在或节点未提供该 lease 证据入口（HTTP 404）；不能据此判断设备恢复状态")
            sys.exit(f"pf-node: lease 证据读取失败：{e}")
        return
    if args[0] == "queue":
        if len(args) != 1:
            sys.exit("用法: pf-node queue")
        print(call("GET", "/queue").decode())
        return
    if args[0] == "release":
        if (len(args) != 4 or not re.fullmatch(r"[0-9a-f]{12}", args[1])
                or args[2] != "--note" or not args[3].strip()):
            sys.exit("用法: pf-node release <12 位任务 id> --note TEXT（填写管理员核查结果）")
        result = release_job(args[1], args[3])
        print(json.dumps(result, ensure_ascii=False))
        sys.exit(0 if result.get("released") is True else 1)
    if args[0] == "cancel":
        if (len(args) not in (2, 3) or (len(args) == 3 and args[2] != "--force")
                or not __import__("re").fullmatch(r"[0-9a-f]{12}", args[1])):
            sys.exit("用法: pf-node cancel <12 位任务 id> [--force]")
        result = cancel_job(args[1], force=len(args) == 3)
        print(json.dumps(result, ensure_ascii=False))
        sys.exit(0 if result.get("accepted") is True else 1)
    if args[0] == "fleet":
        if len(args) == 1:
            wait = 5.0
        elif len(args) == 3 and args[1] == "--wait":
            try:
                wait = float(args[2])
            except ValueError:
                sys.exit("pf-node fleet: --wait 必须是非负秒数")
        else:
            sys.exit("用法: pf-node fleet [--wait N]")
        if not math.isfinite(wait) or wait < 0:
            sys.exit("pf-node fleet: --wait 必须是非负秒数")
        try:
            print(call("GET", f"/fleet?wait={wait:g}", timeout=max(10, wait + 5),
                       attempts=1, raise_4xx=True).decode())
        except ClientError as e:
            if e.code == 404:
                sys.exit("pf-node: 节点不支持 GET /fleet，请升级节点服务（HTTP 404）")
            sys.exit(f"pf-node: {e}")
        return
    if args[0] in ("node", "jobs", "artifacts"):
        cmd = args.pop(0)
        if cmd == "artifacts":
            if not args or not __import__("re").fullmatch(r"[0-9a-f]{12}", args[0]):
                sys.exit("pf-node: artifacts requires a 12-character job id")
            path = f"/jobs/{args.pop(0)}/artifacts"
            allowed = {"--path", "--limit", "--cursor"}
        else:
            path = "/" + cmd
            allowed = {"--query", "--state", "--limit", "--cursor"} if cmd == "jobs" else set()
        query = {}
        while args:
            opt = args.pop(0)
            if opt not in allowed or not args:
                sys.exit(f"pf-node: invalid {cmd} option {opt}")
            query[opt[2:]] = args.pop(0)
        print(call("GET", path + ("?" + urllib.parse.urlencode(query) if query else "")).decode())
        return
    if args[0] == "out" and len(args) == 3:
        fetch_out(args[1], outdir or os.path.join("pf-node-out", args[1]), args[2])
        return
    if args[0] in ("status", "log", "wait", "kill", "out") and len(args) == 2:
        cmd, jid = args
        if cmd == "status":
            print(call("GET", f"/jobs/{jid}").decode())
        elif cmd == "log":
            sys.stdout.buffer.write(call("GET", f"/jobs/{jid}/log"))
        elif cmd == "kill":
            print(call("POST", f"/jobs/{jid}/kill", b"").decode())
        elif cmd == "out":
            fetch_out(jid, outdir or os.path.join("pf-node-out", jid))
        else:
            rc = follow(jid)
            fetch_out(jid, outdir or os.path.join("pf-node-out", jid))
            sys.exit(rc)
        return
    binname, argv = args[0], args[1:]
    require_idempotent_jobs(require_recovery=device_access is not None)
    request_id = request_id or str(uuid.uuid4())
    argv, body = pack(([exe] if exe else []) + argv)
    spec = {"bin": binname, "argv": argv[1:] if exe else argv, "label": label}
    if exe:
        spec["exe"] = argv[0]
    if resources:
        spec["resources"] = resources
    if device_access is not None:
        spec["device_access"] = device_access
    if recovery_for is not None:
        spec["recovery_for"] = recovery_for
    meta = submit_job(spec, body, request_id)
    jid = meta["id"]
    print(f"pf-node: 提交已记录 job={jid} phase={meta.get('phase', 'unknown')} request_id={request_id}",
          file=sys.stderr)
    if detach:
        print(jid)
        return
    rc = follow(jid)
    fetch_out(jid, outdir or os.path.join("pf-node-out", jid))
    sys.exit(rc)


if __name__ == "__main__":
    main()

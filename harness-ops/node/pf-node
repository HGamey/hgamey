def export_caches(clear=False, quota_bytes=None):
    if not TARGET.expected_node_id:
        sys.exit("pf-node: export-caches 需要 --node-id / PF_NODE_ID")
    try:
        if "jobs.export-cache-cleanup-v1" not in TARGET.identity().get("capabilities", []):
            sys.exit("pf-node: 节点未提供 jobs.export-cache-cleanup-v1；未执行")
        if quota_bytes is not None:
            body = json.dumps({"schema": "phonefarm/export-cache-quota@1",
                               "quota_bytes": quota_bytes}).encode()
            value = json.loads(call("POST", "/export-caches/enforce-quota", body,
                                    {"Content-Type": "application/json"}, attempts=1, raise_errors=True))
            print(json.dumps(value, ensure_ascii=False))
            return 0 if value.get("errors") == [] else 2
        body = json.dumps({"schema": "phonefarm/export-cache-clear@1",
                           "confirm": "regenerable-only"}).encode() if clear else None
        value = json.loads(call("POST" if clear else "GET", "/export-caches", body,
                                {"Content-Type": "application/json"} if clear else None,
                                attempts=1, raise_errors=True))
    except ClientError as error:
        print(json.dumps({"http_status": error.code, "retried": False,
                          "error": response_error_code(error.body) or "request_refused"}))
        return 1
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, ValueError):
        print(json.dumps({"retried": False, "error": "request_unconfirmed",
                          "next": clear and "重新查看 export-caches 核对清理结果" or "重试查看"}))
        return 1
    print(json.dumps(value, ensure_ascii=False))
    return 0 if value.get("complete") is True else 2


def retry_finalize(jid):
    try:
        node = json.loads(call("GET", "/node", attempts=1, raise_errors=True))
    except ClientError as e:
        sys.exit(f"pf-node: 无法核对 jobs.durability-v1，请核对访问权限或升级节点：{e}")
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, ValueError) as e:
        sys.exit(f"pf-node: 无法读取节点保存能力：{e}")
    if "jobs.durability-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点未提供 jobs.durability-v1，请升级；尚未发送保存重试")
    try:
        result = json.loads(call("POST", f"/jobs/{jid}/retry-finalize", b"{}",
                                 {"Content-Type": "application/json"}, attempts=1, raise_errors=True))
    except ClientError as e:
        if e.code in (401, 403):
            sys.exit("pf-node: 保存重试被拒绝；需要有效的管理 token")
        sys.exit(f"pf-node: 保存重试未确认：{e}；请先用 {continuation()} status {jid} 核对，不会自动重试")
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, ValueError) as e:
        sys.exit(f"pf-node: 保存结果未确认：{e}；请先用 {continuation()} status {jid} 核对，不会自动重试")
    if result.get("storage_committed") is True:
        print(f"pf-node: 任务 {jid} 的结束记录已提交存储；不代表设备恢复或资源已释放。", file=sys.stderr)
    else:
        reason = ((result.get("job") or {}).get("queue") or {}).get("state_reason")
        print(f"pf-node: 任务 {jid} 结束记录仍未保存，资源保留；原因={json.dumps(reason, ensure_ascii=False)}", file=sys.stderr)
    return result


def follow(jid):
    off = 0
    try:
        while True:
            st = json.loads(call("GET", f"/jobs/{jid}"))
            if st.get("phase") == "storage_blocked":
                print(f"pf-node: 任务 {jid} 结果保存失败（storage_blocked），停止本地跟随并返回125；"
                      f"命令 exit={st.get('exit')}，execution.returncode={(st.get('execution') or {}).get('returncode')}，"
                      f"state_reason={json.dumps((st.get('queue') or {}).get('state_reason'), ensure_ascii=False)}，"
                      f"recovery={json.dumps(st.get('recovery'), ensure_ascii=False)}。"
                      f"原命令不会重跑；核查存储后用 {continuation()} retry-finalize {jid}，不自动下载未提交结果。", file=sys.stderr)
                raise SystemExit(125)
            group = (st.get("execution") or {}).get("owned_process_group") or {}
            reason = (st.get("queue") or {}).get("state_reason") or {}
            if (st.get("state") == "finished" and st.get("exit") is None
                    and (group.get("status") == "not_started" or reason.get("kind") == "cancelled_before_launch")):
                # SQL may confirm no execution even when preparation never created log/out.
                raise SystemExit(terminal_exit(jid, st))
            chunk = call("GET", f"/jobs/{jid}/log?offset={off}")
            if chunk:
                sys.stdout.buffer.write(chunk)
                sys.stdout.flush()
                off += len(chunk)
            if st["state"] == "finished":
                chunk = call("GET", f"/jobs/{jid}/log?offset={off}")
                sys.stdout.buffer.write(chunk)
                return terminal_exit(jid, st)
            time.sleep(1 if chunk else 2)
    except KeyboardInterrupt:
        try:
            cancel_job(jid)
        except SystemExit as e:
            print(f"\npf-node: 未确认取消请求：{e}", file=sys.stderr)
        print(f"pf-node: 已停止本地跟随（130）；收尾仍由节点上的独立 worker 负责。"
              f"请用 {continuation()} status {jid} 或 wait {jid} 确认；这不是任务终态或设备恢复证明。", file=sys.stderr)
        # Do not download a changing output directory as if this were a terminal result.
        raise SystemExit(130)


def job_events_command(args):
    query = {}
    while args:
        option = args.pop(0)
        key = {"--job": "job_id", "--cursor": "cursor", "--after": "after", "--limit": "limit"}.get(option)
        if key is None or not args or key in query:
            sys.exit("用法: pf-node job-events [--job ID] [--cursor C|--after N] [--limit 1..200]")
        value = args.pop(0)
        if key == "job_id" and not re.fullmatch(r"[0-9a-f]{12}", value):
            sys.exit("pf-node: --job 需要 12 位任务 ID")
        if key == "cursor" and not value:
            sys.exit("pf-node: cursor 不能为空；未自动回到流首")
        if key in ("after", "limit"):
            if not re.fullmatch(r"[0-9]{1,19}", value):
                sys.exit(f"pf-node: {option} 需要非负整数")
            value = int(value)
            if not (0 <= value <= (1 << 63) - 1 if key == "after" else 1 <= value <= 200):
                sys.exit(f"pf-node: {option} 超出范围")
        query[key] = value
    if "cursor" in query and "after" in query:
        sys.exit("pf-node: --cursor 与 --after 不能同时使用；原位置未改变")
    if TARGET.expected_node_id is None:
        sys.exit("pf-node: job-events 需要显式 --node-id / PF_NODE_ID；先用 node 核对原节点")
    try:
        node = json.loads(call("GET", "/node", attempts=1, raise_errors=True))
        if "jobs.state-events-v1" not in node.get("capabilities", []):
            sys.exit("pf-node: 节点缺少 jobs.state-events-v1；原 cursor 保留，未读取事件")
        value = json.loads(call("GET", "/job-events" + ("?" + urllib.parse.urlencode(query) if query else ""),
                                attempts=1, raise_errors=True))
        if (not isinstance(value, dict) or value.get("schema_version") != 1
                or value.get("node_id") != TARGET.expected_node_id
                or not isinstance(value.get("items"), list)
                or not isinstance(value.get("next_cursor"), str) or not value["next_cursor"]
                or ("job_id" in query and value.get("job_id") != query["job_id"])):
            raise ValueError("事件回包身份/范围/位置不匹配")
    except ClientError as error:
        sys.exit(f"pf-node: 事件读取失败（HTTP {error.code}）：{error.body.decode('utf-8', errors='replace')}；"
                 "原 cursor/after 保留，未重试或归零")
    except (TargetError, urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, ValueError) as error:
        sys.exit(f"pf-node: 事件读取未确认：{error}；原 cursor/after 保留，未重试或归零")
    except KeyboardInterrupt:
        print("pf-node: 已停止本次只读事件请求（130）；未取消任务，原位置保留。", file=sys.stderr)
        raise SystemExit(130)
    print(json.dumps(value, ensure_ascii=False))


def _extract(data_or_path, dest):
    kw = {"fileobj": io.BytesIO(data_or_path)} if isinstance(data_or_path, bytes) else {"name": data_or_path}
    with tarfile.open(mode="r:gz", **kw) as t:
        members = [m for m in t.getmembers() if m.name not in (".", "./")]
        if not members:
            return False
        os.makedirs(dest, exist_ok=True)
        t.extractall(dest, members=members, filter="data")
    return True


def _sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def download_out(jid, rel, part_dir, *, prefix=None, source_binding=None):
    """分块把 /jobs/<id>/out（或 ?path=rel）下到本地文件，断了从断点续，最后核 sha256。
    返回 (本地文件, 元信息)；节点服务是旧版（不认 meta）时返回 (bytes, None)。"""
    query = {"path": rel} if rel else {}
    if source_binding:
        query["source_revision"] = source_binding["source_revision"]
    base = f"{prefix or '/jobs'}/{jid}/out?" + (urllib.parse.urlencode(query) + "&" if query else "")
    for restart in range(5):
        try:
            raw = call("GET", base + "meta=1", timeout=600, attempts=1, raise_errors=True)
        except ClientError as error:
            sys.exit(f"pf-node: 目录/文件准备失败（HTTP {error.code}）：{error.body.decode('utf-8', errors='replace')}；"
                     "已有本地 partial 保留，未自动重新压缩或降级下载。")
        except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as error:
            sys.exit(f"pf-node: 导出准备结果未确认：{error}；已有本地 partial 保留，未自动重试元数据请求。")
        try:
            meta = json.loads(raw)
        except ValueError:
            if source_binding:
                sys.exit("pf-node: 历史单文件元数据格式未知；保留来源，未降级下载整目录")
            if rel:
                print("pf-node: 节点服务是旧版，不支持只下单个文件，下了整个输出目录", file=sys.stderr)
            return raw, None
        if source_binding and (not isinstance(meta, dict) or any(meta.get(key) != value for key, value in source_binding.items())):
            sys.exit("pf-node: 历史单文件元数据的节点/来源/revision不匹配；未写入或替换本地文件")
        size, etag = meta["size"], meta["etag"]
        if source_binding and meta.get("kind") != "file":
            sys.exit("pf-node: 历史来源仅支持明确单文件；未解包或降级到当前作业")
        identity = (f"{source_binding['node_id']}-{source_binding['source_id']}-r{source_binding['source_revision']}-{jid}"
                    if source_binding else jid)
        part = os.path.join(part_dir, f".pf-node-{identity}-{etag}.part")
        os.makedirs(part_dir, exist_ok=True)
        have = os.path.getsize(part) if os.path.exists(part) else 0
        if have > size:
            os.remove(part)
            have = 0
        if have and have < size:
            print(f"pf-node: 从 {have}/{size} 字节处接着下", file=sys.stderr)
        t0, changed = time.time(), False
        with open(part, "ab") as f:
            while have < size:
                n = min(CHUNK, size - have)
                try:
                    chunk = call("GET", base + urllib.parse.urlencode({"offset": have, "length": n, "etag": etag}),
                                 timeout=120, attempts=8, raise_4xx=True, raise_errors=bool(source_binding), stop_error_codes=EXPORT_ERRORS)
                except ClientError as e:
                    if source_binding and (response_error_code(e.body) or "").startswith("history_"):
                        sys.exit(f"pf-node: 历史读取失败（HTTP {e.code}）：{e.body.decode('utf-8', errors='replace')}；"
                                 f"原来源/revision不变，已有分片保留在 {part}；未自动重选。")
                    if response_error_code(e.body) in EXPORT_ERRORS:
                        sys.exit(f"pf-node: 导出失败（HTTP {e.code}）：{e.body.decode('utf-8', errors='replace')}；"
                                 f"已有分片保留在 {part}；未自动重试、重新压缩或降级下载。")
                    if e.code == 409:  # 节点上输出变了（任务还在写）：从头来
                        changed = True
                        break
                    sys.exit(f"pf-node: {e}")
                if len(chunk) != n:  # 短读：不写，重拿这一块
                    print(f"pf-node: 块 {have} 只收到 {len(chunk)}/{n} 字节，重拿", file=sys.stderr)
                    continue
                f.write(chunk)
                f.flush()
                have += n
                if size > 4 * CHUNK:
                    print(f"\rpf-node: 下载 {have * 100 // size}% ({have >> 20}/{size >> 20} MB)", end="", file=sys.stderr)
        if size > 4 * CHUNK:
            print(f"  {time.time() - t0:.0f}s", file=sys.stderr)
        if changed:
            os.remove(part)
            print("pf-node: 节点上的输出在变（任务还在写？），重新下载", file=sys.stderr)
            continue
        if _sha256(part) == meta["sha256"]:
            return part, meta
        os.remove(part)
        print("pf-node: sha256 对不上，重新下载", file=sys.stderr)
    sys.exit("pf-node: 下载输出反复失败")


def fetch_out(jid, dest, rel=None, *, prefix=None, source_binding=None):
    part_dir = os.path.dirname(os.path.abspath(dest))
    options = {"prefix": prefix, "source_binding": source_binding} if source_binding else {}
    got, meta = download_out(jid, rel, part_dir, **options)
    if meta is None:  # 旧版节点服务：整份 tar.gz
        if _extract(got, dest):
            print(f"pf-node: 输出已下载到 {dest}", file=sys.stderr)
        return
    if meta["kind"] == "file":
        out = os.path.join(dest, meta["path"])
        os.makedirs(os.path.dirname(out), exist_ok=True)
        os.replace(got, out)
        print(f"pf-node: 已下载 {out}（{meta['size']} 字节，sha256 已校验）", file=sys.stderr)
        return
    try:
        sub = os.path.join(dest, meta["path"]) if meta["path"] != "." else dest
        if _extract(got, sub):
            print(f"pf-node: 输出已下载到 {sub}（sha256 已校验）", file=sys.stderr)
    finally:
        os.remove(got)


def history_command(args, outdir):
    """Explicit read scope; never route historical work through current Jobs or follow()."""
    command, rest = args[0], list(args[1:])
    source = revision = None
    remaining = []
    while rest:
        value = rest.pop(0)
        if value in ("--source", "--source-revision"):
            if not rest:
                sys.exit(f"pf-node: {value} 需要一个值")
            content = rest.pop(0)
            if value == "--source":
                if source is not None or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", content):
                    sys.exit("pf-node: --source 需要唯一有效的来源 ID")
                source = content
            else:
                if revision is not None or not re.fullmatch(r"[1-9][0-9]{0,15}", content) or int(content) > 2**53 - 1:
                    sys.exit("pf-node: --source-revision 需要唯一正整数，最大 2^53-1")
                revision = int(content)
        else:
            remaining.append(value)
            if value in ("--query", "--limit", "--cursor", "--path", "--offset") and rest:
                remaining.append(rest.pop(0))
    if command == "job-sources":
        if remaining or source is not None or revision is not None or outdir:
            sys.exit("用法: pf-node job-sources")
    elif source is None or revision is None:
        sys.exit("pf-node: 历史读取需同时显式提供 --source 和 --source-revision；未自动选择 revision")
    if command not in ("job-sources", "jobs", "status", "log", "artifacts", "out"):
        sys.exit("pf-node: --source 仅用于 jobs/status/log/artifacts/out；不支持等待、控制或恢复")
    prefix = f"/job-sources/{urllib.parse.quote(source, safe='')}/jobs" if source else "/job-sources"
    query = {"source_revision": revision} if source else {}
    jid = rel = None
    if command in ("status", "log", "artifacts", "out"):
        if not remaining or not re.fullmatch(r"[0-9a-f]{12}", remaining[0]):
            sys.exit("pf-node: 历史任务需要12位小写十六进制 ID")
        jid = remaining.pop(0)
    if command == "out":
        if len(remaining) != 1 or not remaining[0] or remaining[0] == ".":
            sys.exit("用法: pf-node out JOB FILE --source SOURCE --source-revision N；历史不支持目录下载")
        rel = remaining.pop(0)
    allowed = {"--query", "--limit", "--cursor"} if command == "jobs" else {"--path", "--limit", "--cursor"} if command == "artifacts" else {"--offset", "--limit"} if command == "log" else set()
    while remaining:
        option = remaining.pop(0)
        if option not in allowed or not remaining:
            sys.exit(f"pf-node: 无效历史 {command} 选项 {option}")
        query[option[2:]] = remaining.pop(0)
    if outdir and command != "out":
        sys.exit("pf-node: 历史 --out-dir 仅用于 out 单文件下载")
    try:
        node = TARGET.identity()
        if "jobs.history-read-v1" not in node.get("capabilities", []):
            sys.exit("pf-node: 节点未提供 jobs.history-read-v1；未降级到当前作业")
        if command == "out":
            binding = {"node_id": node["node_id"], "source_id": source, "source_revision": revision}
            dest = outdir or os.path.join("pf-node-out", source, f"revision-{revision}", jid)
            fetch_out(jid, dest, rel, prefix=prefix, source_binding=binding)
            return
        path = prefix + (f"/{jid}" if jid else "") + (f"/{command}" if command in ("log", "artifacts") else "")
        raw = call("GET", path + ("?" + urllib.parse.urlencode(query) if query else ""), attempts=1, raise_errors=True)
        if command == "log":
            sys.stdout.buffer.write(raw)
        else:
            value = json.loads(raw)
            if value.get("node_id") != node["node_id"] or (source and (value.get("source_id") != source or value.get("source_revision") != revision)):
                raise ValueError("历史响应身份不匹配")
            print(raw.decode())
    except ClientError as error:
        sys.exit(f"pf-node: 历史读取失败（HTTP {error.code}）：{error.body.decode('utf-8', errors='replace')}；原来源/revision保留，未自动重选或退回当前作业")
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, ValueError) as error:
        sys.exit(f"pf-node: 历史读取未确认：{error}；原来源/revision保留，未自动重试")


def control_request_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", value):
        sys.exit("pf-node: 会话请求 ID 仅允许 1–64 位 ASCII 字母、数字、下划线和连字符")
    return value


def session_status_json(path):
    """One read, preserving explicit server errors without guessing request existence."""
    status = None
    try:
        body = call("GET", path, attempts=1, raise_errors=True).decode()
        json.loads(body)
        print(body)
        return
    except ClientError as error:
        status = error.code
        try:
            payload = json.loads(error.body)
        except (ValueError, UnicodeError):
            payload = None
        server_error = payload.get("error") if isinstance(payload, dict) else None
        if (isinstance(server_error, dict) and isinstance(server_error.get("code"), str)
                and isinstance(server_error.get("message"), str)):
            code, message = server_error["code"], server_error["message"]
        elif (isinstance(payload, dict) and isinstance(payload.get("code"), str)
              and isinstance(server_error, str)):
            code, message = payload["code"], server_error
        else:
            code, message = "http_error", server_error if isinstance(server_error, str) else error.body.decode(errors="replace")
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as error:
        code, message = "network_error", str(error)
    except (ValueError, UnicodeError) as error:
        code, message = "invalid_response", str(error)
    except Exception as error:
        code, message = "client_error", str(error)
    if TOKEN:
        code, message = str(code).replace(TOKEN, "[credential]"), str(message).replace(TOKEN, "[credential]")
    print(json.dumps({"error": {"code": code, "message": message}, "http_status": status}, ensure_ascii=False))
    raise SystemExit(1)


def execution_reconcile_command(args):
    if (len(args) not in (2, 3) or not re.fullmatch(r"[0-9a-f]{12}", args[1])
            or (len(args) == 3 and args[2] != "--force")):
        sys.exit("用法: pf-node execution-reconcile <任务 id> [--force]")
    try:
        node = json.loads(call("GET", "/node", attempts=1, raise_errors=True))
    except (ClientError, urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, ValueError) as error:
        sys.exit(f"pf-node: 无法核对执行域核查能力：{error}；未发送核查")
    if "jobs.execution-reconcile-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点未提供 jobs.execution-reconcile-v1；未发送核查")
    force = len(args) == 3
    lookup = f"{continuation()} status {args[1]}"
    print(f"pf-node: {'强制操作会结束绑定域内残留进程，再核查并交还输出' if force else '普通核查不杀进程'}；"
          f"仅提交一次，不重放命令。用 {lookup} 查询原任务，不等待核查结束。", file=sys.stderr, flush=True)
    try:
        result = json.loads(call("POST", f"/jobs/{args[1]}/execution/reconcile", json.dumps({"force": force}).encode(),
                                 {"Content-Type": "application/json"}, attempts=1, raise_errors=True))
        if result.get("accepted") is not True or (result.get("job") or {}).get("id") != args[1]:
            raise ValueError("核查回包未确认原任务")
    except (ClientError, urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError,
            ValueError, AttributeError, KeyboardInterrupt) as error:
        print(f"pf-node: 核查提交未确认：{error}；请先用 {lookup} 核对，不自动重发 POST。", file=sys.stderr)
        raise SystemExit(130 if isinstance(error, KeyboardInterrupt) else 1)
    print(json.dumps(result, ensure_ascii=False))
    print(f"pf-node: 已接受原任务核查；用 {lookup} 读取 reconciliation 与 handoff。"
          "complete 只表示宿主域空与输出交还，不代表设备恢复或队列资源释放，原失联/失败记录保留。", file=sys.stderr)


def session_recovery_http_error(error, jid, request_id=None):
    """Expose only bounded error identifiers, never arbitrary response text."""
    code, target = "http_error", None
    try:
        value = json.loads(error.body) if len(error.body) <= (64 << 10) else None
        candidate = value.get("code") if isinstance(value, dict) else None
        if (isinstance(candidate, str) and re.fullmatch(r"[a-z][a-z0-9_]{0,63}", candidate)
                and (not TOKEN or TOKEN not in candidate)):
            code = candidate
        candidate = value.get("target_job_id") if isinstance(value, dict) else None
        if error.code == 409 and isinstance(candidate, str) and re.fullmatch(r"[0-9a-f]{12}", candidate):
            target = candidate
    except (ValueError, UnicodeError, RecursionError):
        pass
    message = ("原入口不是当前阻断叶子；读取计划后显式选择目标，未自动改投"
               if error.code == 409 and code == "session_recovery_leaf" else
               "当前恢复资格不足；读取计划核对阻断原因"
               if error.code == 409 and code == "session_recovery_blocked" else
               "恢复请求被拒绝或未确认；未自动重试")
    result = {"error": {"code": code, "message": message}, "http_status": error.code, "job_id": jid}
    if target is not None:
        result["target_job_id"] = target
    if request_id is not None:
        result["request_id"] = request_id
    print(json.dumps(result, ensure_ascii=False))
    print(f"pf-node: HTTP {error.code}, code={code}；{message}。" +
          (f"当前叶子 target_job_id={target}。" if target is not None else "") +
          f"用 {continuation()} session-recovery {jid} 查询原会话恢复计划。", file=sys.stderr)
    if request_id is not None:
        print(f"pf-node: 保留原入口 {jid} 与 request_id={request_id}；"
              f"用 {continuation()} request {request_id} 查询原请求，不把该 ID 改投其他入口。", file=sys.stderr)
    raise SystemExit(1)


def session_recovery_command(args):
    if len(args) != 2 or not re.fullmatch(r"[0-9a-f]{12}", args[1]):
        sys.exit("用法: pf-node session-recovery <任务 id>")
    try:
        node = json.loads(call("GET", "/node", attempts=1, raise_errors=True))
        capabilities = node.get("capabilities")
        if not isinstance(capabilities, list) or "jobs.session-recovery-chain-v1" not in capabilities:
            sys.exit("pf-node: 节点缺少 jobs.session-recovery-chain-v1；未降级推测恢复叶子")
        value = json.loads(call("GET", f"/jobs/{args[1]}/session/recovery", attempts=1, raise_errors=True))
        if (not isinstance(value, dict) or type(value.get("schema_version")) is not int
                or value["schema_version"] != 1 or value.get("node_id") != node.get("node_id")
                or value.get("job_id") != args[1] or type(value.get("supported")) is not bool
                or type(value.get("eligible")) is not bool):
            raise ValueError("unbound recovery plan")
    except ClientError as error:
        session_recovery_http_error(error, args[1])
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError,
            ValueError, AttributeError, RecursionError):
        sys.exit("pf-node: 原节点恢复计划读取未确认；未推测叶子、未发起恢复")
    print(json.dumps(value, ensure_ascii=False))


def session_recover_command(args, request_id=None):
    if (len(args) not in (2, 4) or not re.fullmatch(r"[0-9a-f]{12}", args[1])
            or (len(args) == 4 and args[2] != "--request-id")):
        sys.exit("用法: pf-node session-recover <任务 id> [--request-id ID]")
    if len(args) == 4:
        supplied = valid_request_id(args[3])
        if request_id is not None and request_id != supplied:
            sys.exit("pf-node: 前后 --request-id 不一致；未提交恢复任务")
        request_id = supplied
    try:
        node = json.loads(call("GET", "/node", attempts=1, raise_errors=True))
    except (ClientError, urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError, ValueError) as error:
        sys.exit(f"pf-node: 无法确认异步会话恢复能力：{error}；未提交恢复任务")
    if "jobs.session-recovery-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.session-recovery-v1；未提交恢复任务")
    request_id = request_id or str(uuid.uuid4())
    lookup = f"{continuation()} request {request_id}"
    retry = f"{continuation()} session-recover {args[1]} --request-id {request_id}"
    print(f"pf-node: 恢复 request_id={request_id}；结果不确定时先用 {lookup} 查询，"
          f"重试须复用同一 ID：{retry}。仅提交一次，不等待恢复完成。", file=sys.stderr, flush=True)
    try:
        job = json.loads(call("POST", f"/jobs/{args[1]}/session/recover", b"{}",
                              {"Content-Type": "application/json", "X-Request-ID": request_id},
                              attempts=1, raise_errors=True))
        if not re.fullmatch(r"[0-9a-f]{12}", str(job.get("id", ""))) or job.get("recovery_for") != args[1]:
            raise ValueError("恢复任务回包未匹配原任务")
    except ClientError as error:
        session_recovery_http_error(error, args[1], request_id)
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError,
            ValueError, AttributeError, KeyboardInterrupt) as error:
        print(f"pf-node: 恢复提交未确认：{error}；用 {lookup} 核对，重试仍用 {retry}；不换 ID 盲目重投。", file=sys.stderr)
        raise SystemExit(130 if isinstance(error, KeyboardInterrupt) else 1)
    print(json.dumps(job, ensure_ascii=False))
    print(f"pf-node: 恢复任务 {job['id']} 已记录，phase={job.get('phase', '未报告')}；"
          "不等待执行结束，不代表设备恢复或原资源已释放。", file=sys.stderr)


def session_command(args):
    if len(args) < 2 or not re.fullmatch(r"[0-9a-f]{12}", args[1]):
        sys.exit("用法: pf-node session-status <任务 id> [--request-id ID] 或 session-action <任务 id> --request FILE|-")
    path = f"/jobs/{args[1]}/session"
    if args[0] == "session-status":
        options, request_id, json_output = args[2:], None, False
        while options:
            option, options = options[0], options[1:]
            if option == "--json" and not json_output:
                json_output = True
            elif option == "--request-id" and options and request_id is None:
                request_id, options = control_request_id(options[0]), options[1:]
            else:
                sys.exit("用法: pf-node session-status <任务 id> [--request-id ID] [--json]")
        if request_id is not None:
            path += "/actions/" + urllib.parse.quote(request_id, safe="")
        if json_output:
            return session_status_json(path)
        print(call("GET", path, attempts=1).decode())
        return
    if len(args) != 4 or args[2] != "--request":
        sys.exit("用法: pf-node session-action <任务 id> --request FILE|-")
    try:
        if args[3] == "-":
            body = sys.stdin.buffer.read((64 << 10) + 1)
        else:
            with open(args[3], "rb") as source:
                body = source.read((64 << 10) + 1)
        if len(body) > 64 << 10:
            sys.exit("pf-node: 动作请求不能超过 64 KiB；未发送")
        value = json.loads(body)
        if not isinstance(value, dict) or value.get("schema") != "phonefarm/gray-control-action@1":
            sys.exit("pf-node: 需要完整 phonefarm/gray-control-action@1 请求；未发送")
        request_id = control_request_id(value.get("request_id", ""))
    except (OSError, ValueError) as error:
        sys.exit(f"pf-node: 无法读取动作 JSON：{error}")
    node = json.loads(call("GET", "/node", attempts=1))
    if "jobs.session-control-v1" not in node.get("capabilities", []):
        sys.exit("pf-node: 节点缺少 jobs.session-control-v1，请升级；未发送动作")
    print(f"pf-node: request_id={request_id}；仅投递一次，accepted 不是执行完成。", file=sys.stderr, flush=True)
    lookup = f"{continuation()} session-status {args[1]} --request-id {request_id}"
    try:
        result = json.loads(call("POST", path + "/actions", body,
                                 {"Content-Type": "application/json"}, attempts=1, timeout=15, raise_4xx=True))
        if result.get("request_id") != request_id or result.get("schema") != "phonefarm/gray-control-action-result@1":
            raise ValueError("动作回执不匹配")
    except ClientError as error:
        sys.exit(f"pf-node: 动作被拒绝：{error}；先用 {lookup} 核对，不换 ID 盲重发。")
    except (SystemExit, ValueError, AttributeError, KeyboardInterrupt) as error:
        print(f"pf-node: 动作结果未确认：{error}；请用 {lookup} 查询。不要换 ID 重复输入。", file=sys.stderr)
        raise SystemExit(130 if isinstance(error, KeyboardInterrupt) else 1)
    print(json.dumps(result, ensure_ascii=False))
    print(f"pf-node: status={result.get('status')}；用 {lookup} 读取最新回执。", file=sys.stderr)


def main():
    global URL, TOKEN, TARGET, CHUNK
    args, outdir, detach, label, exe = sys.argv[1:], None, False, os.environ.get("DEVLOCK_LABEL"), None
    connection_url = expected_node_id = explicit_file = None
    request_id, resources = None, []
    priority = None
    device_access, recovery_for, execution_policy = None, None, None
    inputs_path, inputs, submission_node = None, None, None
    actor_id = None
    binding_path, binding_envelope = None, None
    host_slots_path, host_slots = None, None
    disk_guard_path, disk_guard = None, None
    wall_seconds, timeout_action, time_budget = None, None, None
    while args and args[0].startswith("-"):
        a = args.pop(0)
        if a in ("--url", "--node-id", "--token-file"):
            if not args:
                sys.exit(f"pf-node: {a} 需要一个值")
            value = args.pop(0)
            if a == "--url":
                connection_url = value
            elif a == "--node-id":
                expected_node_id = value
            else:
                explicit_file = value
        elif a in ("-o", "--out-dir"):
            outdir = args.pop(0)
        elif a == "--detach":
            detach = True
        elif a == "--exe":
            exe = args.pop(0)
        elif a == "--label":
            label = args.pop(0)
        elif a == "--actor-id":
            if not args or actor_id is not None:
                sys.exit("pf-node: --actor-id 需要且只能指定一次")
            actor_id = args.pop(0)
        elif a == "--inputs":
            if not args or inputs_path is not None:
                sys.exit("pf-node: --inputs 需要且只能指定一个清单文件")
            inputs_path = args.pop(0)
        elif a == "--host-slots":
            if not args or host_slots_path is not None:
                sys.exit("pf-node: --host-slots 需要且只能指定一个 JSON 文件")
            host_slots_path = args.pop(0)
        elif a == "--disk-guard":
            if not args or disk_guard_path is not None:
                sys.exit("pf-node: --disk-guard 需要且只能指定一个 JSON 文件")
            disk_guard_path = args.pop(0)
        elif a == "--device-binding":
            if not args or binding_path is not None:
                sys.exit("pf-node: --device-binding 需要且只能指定一个 devices-resolve JSON 文件")
            binding_path = args.pop(0)
        elif a == "--request-id":
            if not args:
                sys.exit("pf-node: --request-id 需要一个 ID")
            request_id = valid_request_id(args.pop(0))
        elif a == "--priority":
            if not args or priority is not None or not re.fullmatch(r"-?[0-9]{1,2}", args[0]) or not -10 <= int(args[0]) <= 10:
                sys.exit("pf-node: --priority 需要一个 -10..10 的整数")
            priority = int(args.pop(0))
        elif a == "--resource":
            if not args or not args[0].strip():
                sys.exit("pf-node: --resource 需要一个独占资源名称")
            resources.append(args.pop(0))
        elif a == "--device-access":
            if not args or args[0] not in ("none", "write", "recovery"):
                sys.exit("pf-node: --device-access 必须为 none、write 或 recovery")
            value = args.pop(0)
            if device_access is not None and device_access != value:
                sys.exit("pf-node: --device-access 不能声明互相矛盾的模式")
            device_access = value
        elif a == "--max-runtime-seconds":
            if not args or not re.fullmatch(r"[0-9]{1,6}", args[0]) or not 1 <= int(args[0]) <= 604800:
                sys.exit("pf-node: --max-runtime-seconds 必须为 1–604800 的整数秒")
            value = int(args.pop(0))
            if wall_seconds is not None and wall_seconds != value:
                sys.exit("pf-node: --max-runtime-seconds 不能声明互相矛盾的值")
            wall_seconds = value
        elif a == "--timeout-action":
            if not args or args[0] not in ("graceful", "escalate"):
                sys.exit("pf-node: --timeout-action 必须为 graceful 或 escalate")
            value = args.pop(0)
            if timeout_action is not None and timeout_action != value:
                sys.exit("pf-node: --timeout-action 不能声明互相矛盾的动作")
            timeout_action = value
        elif a == "--execution-policy":
            if not args or args[0] not in ("process_group", "contained"):
                sys.exit("pf-node: --execution-policy 必须为 process_group 或 contained")
            value = args.pop(0)
            if execution_policy is not None and execution_policy != value:
                sys.exit("pf-node: --execution-policy 不能声明互相矛盾的策略")
            execution_policy = value
        elif a == "--recovery-for":
            if not args or not re.fullmatch(r"[0-9a-f]{12}", args[0]):
                sys.exit("pf-node: --recovery-for 需要原资源保留任务的 12 位 ID")
            value = args.pop(0)
            if recovery_for is not None and recovery_for != value:
                sys.exit("pf-node: --recovery-for 只能指定一个恢复目标")
            recovery_for = value
        elif a in ("-h", "--help"):
            print(__doc__)
            return
        else:
            sys.exit(f"pf-node: 未知选项 {a}")
    if host_slots_path is not None and device_access == "recovery":
        sys.exit("pf-node: 恢复任务暂不接受显式宿主 slots；未提交")
    if disk_guard_path is not None and device_access == "recovery":
        sys.exit("pf-node: 恢复任务暂不接受磁盘软保护声明；未提交")
    if timeout_action is not None and wall_seconds is None:
        sys.exit("pf-node: --timeout-action 需与 --max-runtime-seconds 一起使用")
    if wall_seconds is not None:
        if device_access == "recovery":
            sys.exit("pf-node: 恢复任务暂不接受运行预算；未提交")
        time_budget = {"wall_seconds": wall_seconds, "timeout_action": timeout_action or "graceful"}
    if not args:
        print(__doc__)
        return
    if args[0] == "live" and (len(args) == 1 or any(arg in ("--help", "-h") for arg in args[1:])):
        from live_client import main as live_main
        return live_main(None, ["--help"])
    if args == ["games", "--help"] or args == ["games", "-h"]:
        from game_client import HELP
